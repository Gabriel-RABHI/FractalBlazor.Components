@inherits ListBase
@using Microsoft.FluentUI.AspNetCore.Components

@for (var i = 0; i < Rows; i++)
{
    <FluentCard Appearance="CardAppearance.Outline">
        <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" HorizontalGap="8px">
            <FluentText Size="TextSize.Size200">Row @i, generation @Generation</FluentText>
        </FluentStack>
    </FluentCard>
}
