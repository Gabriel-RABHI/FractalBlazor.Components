@* Each field binds a property of the applicant. *@
<MudStack Row Spacing="2" AlignItems="AlignItems.Center">
    <MudTextField T="string" @bind-Value="Applicant.FirstName" Label="First Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField T="string" @bind-Value="Applicant.LastName" Label="Last Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField T="string" @bind-Value="Applicant.City" Label="City" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudCheckBox T="bool" @bind-Value="Applicant.Interviewed" Label="Interviewed" Dense />
    <MudSelect T="ApplicantStatus" @bind-Value="Applicant.Status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense">
        @foreach (var status in ApplicantDto.Statuses)
        {
            <MudSelectItem Value="status">@status</MudSelectItem>
        }
    </MudSelect>
</MudStack>

@code {
    [Parameter]
    public ApplicantDto Applicant { get; set; } = default!;
}
