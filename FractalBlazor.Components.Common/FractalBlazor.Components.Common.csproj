<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Contracts shared by FractalBlazor states and views: actions, change notification and view registration.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: not every public member is documented yet; the DSL flags are. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
