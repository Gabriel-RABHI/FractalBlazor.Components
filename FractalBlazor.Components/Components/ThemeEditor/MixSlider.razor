@* One mix value of the theme, in percent, sent while the thumb moves. *@
<FbInputRange TValue="double" TAction="FbSetValue<double>" Value="Value" ValueChanged="ValueChanged"
              Min="0" Max="Max" Step="0.5" Immediate>
    <StartContent>
        <FbRowItem Style="min-width:6.5rem"><FbText S Subtle>@Label</FbText></FbRowItem>
    </StartContent>
    <EndContent>
        <FbRowItem Style="min-width:3rem;justify-content:flex-end"><FbText S>@ThemeEditorModel.Css(Value)</FbText></FbRowItem>
    </EndContent>
</FbInputRange>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public double Value { get; set; }

    [Parameter]
    public EventCallback<double> ValueChanged { get; set; }

    [Parameter]
    public double Max { get; set; } = 100;
}
