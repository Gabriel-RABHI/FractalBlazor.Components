@* A section of the top menu. It re-renders alone when its selection changes. *@
@attribute [ViewFor<ViewSelector>(typeof(SectionState), ViewSelector.Viewer)]

<FbButton Handler="Item" Action="@Select" Icon="@MenuIntents.Icon(Item.Intent)"
          WBH="@Item.IsSelected" WBN="@(!Item.IsSelected)" WFN PVS PHM>
    <FbText S Highlight="@Item.IsSelected" Muted="@(!Item.IsSelected)">@MenuIntents.Label(Item.Intent)</FbText>
</FbButton>

@code {
    private static readonly SelectableEntryState.Select Select = new();

    [Parameter]
    public SectionState Item { get; set; } = default!;
}
