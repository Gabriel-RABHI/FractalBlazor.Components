@page "/theme"
@rendermode InteractiveServer
@inject IFbFormThemeRegistry Registry

@using FractalBlazor.Components.Components.ThemeEditor
@using FractalBlazor.Components.Forms.Contracts
@using FractalBlazor.Components.Forms.Theming.Helpers

<PageTitle>Éditeur de thème</PageTitle>

<FbStack GL>
    <FbText XL B>Éditeur de thème</FbText>
    <FbText M Muted>
        Les réglages construisent un FbThemeSetup dérivé du thème par défaut. L’aperçu l’applique
        avec un FbTheme Scoped, sans toucher au reste de la page. Changer de branche repart des
        valeurs de cette branche.
    </FbText>

    <FbGridContainer Columns="1" ColumnsM="2" ColumnsXL="3" GL JVS>
        <FbGridItem>
            <FbStack GM PL WBA WFL WRL>
                <FbText L B>Couleurs</FbText>
                <FbSelect TValue="string" TAction="FbSetValue<string>" Items="ThemeEditorModel.Branches"
                          Value="@_model.Branch" ValueChanged="LoadBranch">
                    <StartContent><FbRowItem Style="min-width:6.5rem"><FbText S Subtle>Branche</FbText></FbRowItem></StartContent>
                </FbSelect>
                <FbSelect TValue="string" TAction="FbSetValue<string>" Items="_model.VariantNames"
                          @bind-Value="_model.SelectedVariant">
                    <StartContent><FbRowItem Style="min-width:6.5rem"><FbText S Subtle>Variante</FbText></FbRowItem></StartContent>
                </FbSelect>
                <ColorField Label="Fond bas" @bind-Value="_model.Selected.BgLow" />
                <ColorField Label="Fond haut" @bind-Value="_model.Selected.BgHigh" />
                <ColorField Label="Texte bas" @bind-Value="_model.Selected.FgLow" />
                <ColorField Label="Texte haut" @bind-Value="_model.Selected.FgHigh" />
                <FbRow JHE>
                    <FbButton WBN Icon="@FbMaterialIcons.RestartAlt" OnClick="() => LoadBranch(_model.Branch)">
                        <FbText S>Réinitialiser</FbText>
                    </FbButton>
                </FbRow>
            </FbStack>
        </FbGridItem>

        <FbGridItem>
            <FbStack GM PL WBA WFL WRL>
                <FbText L B>Surfaces et frames</FbText>
                <MixSlider Label="Surface" Max="40" @bind-Value="_model.SurfaceMix" />
                <MixSlider Label="Accent" Max="40" @bind-Value="_model.AccentOffset" />
                <MixSlider Label="Highlight" Max="60" @bind-Value="_model.HighlightOffset" />
                <MixSlider Label="Frame Light" Max="60" @bind-Value="_model.FrameLight" />
                <MixSlider Label="Frame Medium" Max="60" @bind-Value="_model.FrameMedium" />
                <MixSlider Label="Frame Strong" Max="60" @bind-Value="_model.FrameStrong" />
            </FbStack>
        </FbGridItem>

        <FbGridItem>
            <FbStack GM PL WBA WFL WRL>
                <FbText L B>Textes</FbText>
                <MixSlider Label="Subtle" @bind-Value="_model.TextSubtle" />
                <MixSlider Label="Muted" @bind-Value="_model.TextMuted" />
                <MixSlider Label="Default" @bind-Value="_model.TextDefault" />
                <MixSlider Label="Highlight" @bind-Value="_model.TextHighlight" />

                <FbText L B>Contraste WCAG</FbText>
                <FbText XS Muted>Plus faible ratio de chaque texte, sur tous les fonds de toutes les variantes.</FbText>
                @foreach (var (text, entry) in WorstContrasts)
                {
                    <FbVariant Variant="@(entry.MeetsAA ? FbThemeVariants.Success : entry.MeetsAALarge ? FbThemeVariants.Warning : FbThemeVariants.Error)">
                        <FbRow GS PS PHM WBA WRM>
                            <FbText S B>@text</FbText>
                            <FbText S>@entry.Ratio.ToString("0.0"):1</FbText>
                            <FbRowSpacer />
                            <FbText XS Muted>@entry.Variant sur @entry.Background</FbText>
                        </FbRow>
                    </FbVariant>
                }
            </FbStack>
        </FbGridItem>
    </FbGridContainer>

    <FbTheme Setup="@_model.Setup" Branch="@_model.Branch" Scoped>
        <ThemePreview />
    </FbTheme>

    <FbStack GS PL WBA WFL WRL>
        <FbText L B>Code du thème</FbText>
        <FbText XS Muted>Seules les valeurs modifiées sont déclarées : le reste est hérité du thème par défaut.</FbText>
        <pre style="margin:0;overflow:auto"><code>@_model.ToCSharp()</code></pre>
    </FbStack>
</FbStack>

@code {
    private ThemeEditorModel _model = default!;
    private int _contrastVersion = -1;
    private IReadOnlyList<(FbContrastText Text, FbContrastEntry Entry)> _worst = [];

    protected override void OnInitialized() => _model = new ThemeEditorModel(Registry);

    private void LoadBranch(string branch) => _model.Load(branch);

    /// <summary>
    /// Recomputed only when the edited theme changes.
    /// </summary>
    private IReadOnlyList<(FbContrastText Text, FbContrastEntry Entry)> WorstContrasts
    {
        get
        {
            if (_contrastVersion != _model.Version)
            {
                var report = FbThemeContrast.Analyze(Registry.Resolve(_model.Setup, _model.Branch));
                _worst = report.Entries
                    .GroupBy(entry => entry.Text)
                    .Select(group => (group.Key, group.MinBy(entry => entry.Ratio)!))
                    .ToList();
                _contrastVersion = _model.Version;
            }
            return _worst;
        }
    }
}
