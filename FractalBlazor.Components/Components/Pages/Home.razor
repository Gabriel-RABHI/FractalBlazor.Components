@page "/"
@rendermode InteractiveServer

@using FractalBlazor.Components.Layout.Colors

<PageTitle>Layout et theming</PageTitle>

<FbStack GL>
    <FbText XL B>Surfaces et frames</FbText>
    <FbRow GL WFM WSS WRL PL WBA>
        <FbRow GL WFL PL WBH WRM Hover>
            <FbText XS T>Home</FbText>
            <FbText S T>Home</FbText>
            <FbText M T>Home</FbText>
            <FbText L T>Home</FbText>
            <FbText XL T>Home</FbText>
            <FbText XXL T>Home</FbText>
        </FbRow>
        <FbRow GL WFS PM WBS SJVS>
            <FbText S>Home</FbText>
            <FbText M>Home</FbText>
            <FbText L>Home</FbText>
            <FbText XL>Home with <b>bold</b></FbText>
        </FbRow>
        <FbRow GL WFM PM Hover SJVE JVBl>
            <FbText S B>Home</FbText>
            <FbText M B>Home</FbText>
            <FbText L B>Home</FbText>
            <FbRowItem SJVBl>
                <FbText XL B>Home</FbText>
            </FbRowItem>
        </FbRow>
    </FbRow>

    <FbText XL B>Couleurs de texte</FbText>
    <FbRow GL WGM PM>
        <FbText M Subtle>Subtle</FbText>
        <FbText M Muted>Muted</FbText>
        <FbText M>Default</FbText>
        <FbText M Highlight>Highlight</FbText>
    </FbRow>

    <FbText XL B>Variantes</FbText>
    <FbRow GL WGM PM MultiLine>
        @foreach (var variant in FbThemeVariants.Standard)
        {
            <FbVariant Variant="@variant">
                <FbRow GM PM WGM WRM NoFlex>
                    <FbText S Subtle>@variant</FbText>
                </FbRow>
                <FbRow GM PM WGM WRM NoFlex WBS>
                    <FbText S Muted>Surface</FbText>
                </FbRow>
                <FbRow GM PM WGM WRM NoFlex WBA>
                    <FbText S>Accent</FbText>
                </FbRow>
                <FbRow GM PM WGM WRM NoFlex WBH>
                    <FbText S Highlight>Highlight</FbText>
                </FbRow>
            </FbVariant>
        }
    </FbRow>

    <FbText XL B>Inversion locale et thème local</FbText>
    <FbRow GL>
        <FbVariant SB SF>
            <FbStack GS PL WBS WFM WRL>
                <FbText L B>Inversion SB SF</FbText>
                <FbText M Muted>Les ancres de la variante sont inversées : la carte passe au clair sans nouvelle branche.</FbText>
                <FbCircularProgress />
            </FbStack>
        </FbVariant>
        <FbTheme Branch="@FbThemeBranches.Light" Scoped>
            <FbStack GS PL WBS WFM WRL>
                <FbText L B>Îlot Light</FbText>
                <FbText M Muted>Un FbTheme Scoped pose la branche Light sur ce seul sous-arbre.</FbText>
                <FbVariant Variant="@FbThemeVariants.Error">
                    <FbRow GS PM WBA WFM WRM>
                        <FbIcon Icon="@FbMaterialIcons.Info" />
                        <FbText S>Variante Error dans l’îlot</FbText>
                    </FbRow>
                </FbVariant>
            </FbStack>
        </FbTheme>
    </FbRow>

    <FbText XL B>Grille responsive</FbText>
    <FbGridContainer Columns="4" ColumnsS="6" ColumnsM="8" GM>
        <FbGridItem ColumnSpan="4" ColumnSpanS="4" ColumnSpanM="4" WBA WFM WRM PM>
            <FbText S Muted>4 colonnes, puis 4 sur 6, puis 4 sur 8</FbText>
        </FbGridItem>
        <FbGridItem ColumnSpan="2" ColumnSpanS="2" ColumnSpanM="2" WBA WFM WRM PM>
            <FbText M Muted>2 colonnes</FbText>
        </FbGridItem>
        <FbGridItem ColumnSpan="2" ColumnSpanS="3" ColumnSpanM="1" WBH WFM WRM PM>
            <FbText M Muted>Item</FbText>
        </FbGridItem>
        <FbGridItem ColumnSpan="2" ColumnSpanS="3" ColumnSpanM="1" WBH WFM WRM PM>
            <FbText M Muted>Item</FbText>
        </FbGridItem>
    </FbGridContainer>

    <FbText XL B>Palette de base</FbText>
    <div>
        @((MarkupString)FbThemeBaseColors.HtmlView)
    </div>
</FbStack>
