            </FbRow>
        </FbVariant>
        
        <FbVariant Variant="@FbThemeVariants.Success">
            <FbRow GL PM WGM>
                <FbText S Subtle>Success No back</FbText>
            </FbRow>
            <FbRow GL PM WGM WBS>
                <FbText S Muted>Surface</FbText>
            </FbRow>
            <FbRow GL PM WGM WBA>
                <FbText S>Accent</FbText>
            </FbRow>
            <FbRow GL PM WGM WBH>
                <FbText S Highlight>Highlight</FbText>
            </FbRow>
        </FbVariant>
    </FbRow>
    <FbGridContainer ColumnsXS="4" ColumnsS="6" ColumnsM="8" GM PL>
        <FbGridItem ColumnSpanXS="2" ColumnSpanS="4" ColumnSpanM="4" Style="background:#800">
            <FbText S Muted>Home of the layout and form library</FbText>
        </FbGridItem>
        <FbGridItem ColumnSpanXS="2" ColumnSpanS="4" ColumnSpanM="2" Style="background:#080">
            <FbText M Muted>Home of the layout and form library</FbText>
        </FbGridItem>
        <FbGridItem ColumnSpanXS="2" ColumnSpanS="4" ColumnSpanM="1" Style="background:#088" PM VO_M>
            <FbText L Muted>Home of the layout and form library</FbText>
        </FbGridItem>
        <FbGridItem ColumnSpanXS="2" ColumnSpanS="6" ColumnSpanM="1" Style="background:#08F">
            <FbText XL Muted>Home_of_the_layout_and_form_library</FbText>
        </FbGridItem>
    </FbGridContainer>
    <FbRow GM PL>
        <FbRowItem>
        <FbInputText Handler="this" TAction="ChangeFirstNameAction" Value="@FirstName">
            <StartContent>
                <FbText M Subtle>Name</FbText>
            </StartContent>
        </FbInputText>
        </FbRowItem>
        <FbRowItem>
            <FbInputText Handler="this" TAction="ChangeFirstNameAction" Value="@FirstName"/>
        </FbRowItem>
        <FbVariant Variant="@FbThemeVariants.Error">
            <FbInputText Handler="this" TAction="ChangeFirstNameAction" Value="@FirstName">
                <StartContent>
                    <FbText M Subtle>Name</FbText>
                </StartContent>
            </FbInputText>
        </FbVariant>
    </FbRow>
    <div>
        @((MarkupString)FbThemeBaseColors.HtmlView)
    </div>
</FbStack>

@code {
    public record ChangeFirstNameAction(string NewValue) : IStateAction<string>;

    public void Handle(ChangeFirstNameAction a) => FirstName = a.NewValue;

    public string FirstName { get; set; } = "Toto";

    private bool _isOpen1;
    public bool IsOpen1
    {
        get => _isOpen1;
        set => _isOpen1 = value;
    }

    private bool _isOpen2;
    private string _selectedOption1 = "";
    private string _selectedOption2 = "";
    private string _searchQuery = "";

    private string _defaultBg = "#ffffff";
    private string _accentBg = "#fafafa";
    private string _highlightBg = "#e8f3ff";

    private string _smallFrameSize = "0.07rem";
    private string _smallFrameColor = "#e2e2e2";

    private string _mediumFrameSize = "0.07rem";
    private string _mediumFrameColor = "#cecece";

    private string _largeFrameSize = "0.14rem";
    private string _largeFrameColor = "#e2e2e2";

    private void ResetTheme()
    {
        _defaultBg = "#ffffff";
        _accentBg = "#fafafa";
        _highlightBg = "#e8f3ff";

        _smallFrameSize = "0.07rem";
        _smallFrameColor = "#e2e2e2";

        _mediumFrameSize = "0.07rem";
        _mediumFrameColor = "#cecece";

        _largeFrameSize = "0.14rem";
        _largeFrameColor = "#e2e2e2";
    }

    private readonly string[] Users = { "Gabriel", "Alice", "Bob", "Charlie", "David", "Emma", "Frank", "Grace" };

    private System.Collections.Generic.IEnumerable<string> FilteredUsers => 
        string.IsNullOrWhiteSpace(_searchQuery) 
            ? Users 
            : System.Linq.Enumerable.Where(Users, u => u.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        _isOpen2 = true;
    }

    private void SelectOption(int dropdownNum, string option)
    {
        if (dropdownNum == 1)
        {
            _selectedOption1 = option;
            _isOpen1 = false;
        }
        else if (dropdownNum == 2)
        {
            _selectedOption2 = option;
            _searchQuery = option;
            _isOpen2 = false;
        }
    }
}
