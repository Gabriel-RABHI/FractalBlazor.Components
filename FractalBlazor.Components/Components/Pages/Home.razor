@page "/"

<PageTitle>FractalBlazor</PageTitle>

@* The whole site comes from FractalBlazor.WebSite; this host only reads the theme cookie
   during its static render, so the first paint has the right theme. *@
<WebSiteApplication @rendermode="InteractiveServer" InitialMode="@ThemeCookie.Parse(HttpContext?.Request.Cookies[ThemeCookie.Name])" />

@code {
    /// <summary>
    /// Available during the static server render of this page.
    /// </summary>
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }
}
