@using FractalBlazor.Components.Forms.Theming.Constants
@using FractalBlazor.Components.Layout.Colors


<FbStack MS PL GL WRX WFS WBS>
    <FbRow GL WFM WSS WRL PL WBA>
        <FbRow GL WFL PL WBH WRM Hover>
            <FbText XS T>Home</FbText>
            <FbText S T>Home</FbText>
            <FbText M T>Home</FbText>
            <FbText L T>Home</FbText>
            <FbText XL T>Home</FbText>
            <FbText XXL T>Home</FbText>
        </FbRow>
        <FbRow GL WFS PM WBS SJVS>
            <FbText S>Home</FbText>
            <FbText M>Home</FbText>
            <FbText L>Home</FbText>
            <FbText XL>Home with <b>bold</b></FbText>
        </FbRow>
        <FbRow GL WFM PM Hover SJVE JVBl>
            <FbText S B>Home</FbText>
            <FbText M B>Home</FbText>
            <FbText L B>Home</FbText>
            <FbRowItem SJVBL>
                <FbText XL B>Home</FbText>
            </FbRowItem>
        </FbRow>
        <FbRow GL PM SJVSt WSM JVSt WFS>
            <FbRowItem PHM SJVBl>
                <FbText S XB>Home 1</FbText>
            </FbRowItem>
            <FbRowItem PHM SJVBl>
                <FbText M XB>Home 2</FbText>
            </FbRowItem>
            <FbRowItem PHM>
                <FbText L XB>Home 3</FbText>
            </FbRowItem>
            <FbRowItem PHM>
                <FbText XL XB>Home 4</FbText>
            </FbRowItem>
        </FbRow>
    </FbRow>
    <FbRow GL WGM PM>
        <FbRow GL WGM PM>
            <FbText S Subtle>Home</FbText>
            <FbText M Subtle>Home</FbText>
            <FbText L Subtle>Home</FbText>
            <FbText XL Subtle>Home</FbText>
        </FbRow>
    </FbRow>
    <FbRow GL WGM PM>
        <FbRow GL WGM PM>
            <FbText S Muted>Home</FbText>
            <FbText M Muted>Home</FbText>
            <FbText L Muted>Home</FbText>
            <FbText XL Muted>Home</FbText>
        </FbRow>
    </FbRow>
    <FbRow GL WGM PM>
        <FbVariant Variant="@FbThemeVariants.Selected">
            <FbRow GL PM WGM>
                <FbText S Subtle>Select No back</FbText>
            </FbRow>
            <FbRow GL PM WGM WBS>
                <FbText S Muted>Surface</FbText>
            </FbRow>
            <FbRow GL PM WGM WBA>
                <FbText S>Accent</FbText>
            </FbRow>
            <FbRow GL PM WGM WBH>
                <FbText S Highlight>Highlight</FbText>
            </FbRow>
        </FbVariant>
        <FbVariant Variant="@FbThemeVariants.Error">
            <FbRow GL PM WGM>
                <FbText S Subtle>Error No back</FbText>
            </FbRow>
            <FbRow GL PM WGM WBS>
                <FbText S Muted>Surface</FbText>
            </FbRow>
            <FbRow GL PM WGM WBA>
                <FbText S>Accent</FbText>
            </FbRow>
            <FbRow GL PM WGM WBH>
                <FbText S Highlight>Highlight</FbText>
            </FbRow>
        </FbVariant>
        <FbVariant Variant="@FbThemeVariants.Disabled">
            <FbRow GL PM WGM>
                <FbText S Subtle>Disabled No back</FbText>
            </FbRow>
            <FbRow GL PM WGM WBS>
                <FbText S Muted>Surface</FbText>
            </FbRow>
            <FbRow GL PM WGM WBA>
                <FbText S>Accent</FbText>
            </FbRow>
            <FbRow GL PM WGM WBH>
