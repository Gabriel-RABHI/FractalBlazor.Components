@page "/"

<PageTitle>FractalBlazor</PageTitle>

<DemoApplication @rendermode="InteractiveServer" InitialMode="@InitialMode" />

@code {
    /// <summary>
    /// Available during the static server render of this page.
    /// </summary>
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private ThemeMode InitialMode
        => HttpContext?.Request.Cookies[ThemeSelectorView.Cookie] == FbThemeBranches.Light
            ? ThemeMode.Light
            : ThemeMode.Dark;
}
