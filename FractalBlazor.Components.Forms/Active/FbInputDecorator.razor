<FbStack PS MinWidth="100px">
     <FbBlazor.Utilities.Design.Typography.FbLabel>
         @Label
     </FbBlazor.Utilities.Design.Typography.FbLabel>
     <FbStackItem Flex="3">
         @ChildContent
     </FbStackItem>
 </FbStack>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string Label { get; set; }
}
