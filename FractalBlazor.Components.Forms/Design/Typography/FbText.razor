@namespace  FractalBlazor.Components.Layout
@inherits FbComponentBase

@if (Bold)
{
    <div class="@ComputedTextClasses" style="@ComputedBaseStyle"><b>@ChildContent</b></div>
} else
{
    <div class="@ComputedTextClasses" style="@ComputedBaseStyle">@ChildContent</div>
}

@code {
    private FbTextScale _scale = FbTextScale.Text;
    private FbTextSize _size = FbTextSize.M;
    private FbTextType _type = FbTextType.None;
    private bool _bold = false;
    private bool _noWrap = false;
    private bool _required = false;

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    // -------------- FbText Scale ------------ //
    protected FbTextScale Scale { get => _scale; set => _scale = value; }

    private string TextScaleString
    {
        get
        {
            switch (_scale)
            {
                case FbTextScale.Title:
                    return "fb-title";
                case FbTextScale.Subtitle:
                    return "fb-subtitle";
                case FbTextScale.Label:
                    return "fb-label";
                case FbTextScale.Text:
                    return "fb-text";
            }
            return "";
        }
    }

    // -------------- FbText Size ------------ //
    [Parameter]
    public bool L
    {
        get => _size == FbTextSize.L;
        set
        {
            if (value) _size = FbTextSize.L;
        }
    }

    [Parameter]
    public bool M
    {
        get => _size == FbTextSize.M;
        set
        {
            if (value) _size = FbTextSize.M;
        }
    }

    [Parameter]
    public bool S
    {
        get => _size == FbTextSize.S;
        set
        {
            if (value) _size = FbTextSize.S;
        }
    }

    [Parameter]
    public bool Bold {
        get => _bold;
        set => _bold = value;
    }

    private string TextSizeString
    {
        get
        {
            switch (_size)
            {
                case FbTextSize.L:
                    return $"{TextScaleString}-l";
                case FbTextSize.M:
                    return $"{TextScaleString}-m";
                case FbTextSize.S:
                    return $"{TextScaleString}-s";
            }
            return "";
        }
    }

    // -------------- FbText Type ------------ //
    [Parameter]
    public bool Success
    {
        get => _type == FbTextType.Success;
        set
        {
            if (value) _type = FbTextType.Success;
        }
    }

    [Parameter]
    public bool Warning
    {
        get => _type == FbTextType.Warning;
        set
        {
            if (value) _type = FbTextType.Warning;
        }
    }

    [Parameter]
    public bool Error
    {
        get => _type == FbTextType.Error;
        set
        {
            if (value) _type = FbTextType.Error;
        }
    }

    [Parameter]
    public bool Required
    {
        get => _required;
        set => _required = value;
    }

    [Parameter]
    public bool NoWrap
    {
        get => _noWrap;
        set => _noWrap = true;
    }

    [Parameter]
    public bool Wrap
    {
        get => !_noWrap;
        set => _noWrap = false;
    }

    private string TextTypeString
    {
        get
        {
            switch (_type)
            {
                case FbTextType.Success:
                    return "fb-text-success";
                case FbTextType.Warning:
                    return "fb-text-warning";
                case FbTextType.Error:
                    return "fb-text-error";
            }
            return "";
        }
    }

    private string TypeClassString
    {
        get
        {
            return (_noWrap ? "fb-text-no-wrap" : "") +
                   (_required ? "fb-text-required" : "");
        }
    }

    protected string ComputedTextClasses
    {
        get
        {
            return $"{TextScaleString} {TextSizeString} {TextTypeString} {TypeClassString}"; ;
        }
    }
}
