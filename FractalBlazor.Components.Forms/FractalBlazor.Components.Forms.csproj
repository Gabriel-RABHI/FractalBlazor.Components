<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>State-first Blazor fields and buttons, with full theming (Dark and Light branches, variants), built on FractalBlazor Layout.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: not every public member is documented yet; the DSL flags are. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- BL0007: the boolean DSL is made of parameters with logic, each flag writing into packed state. -->
    <NoWarn>$(NoWarn);BL0007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <InternalsVisibleTo Include="FractalBlazor.Components.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FractalBlazor.Components.Common\FractalBlazor.Components.Common.csproj" />
    <ProjectReference Include="..\FractalBlazor.Components.Layout\FractalBlazor.Components.Layout.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\MultiSelectors\" />
  </ItemGroup>

</Project>
