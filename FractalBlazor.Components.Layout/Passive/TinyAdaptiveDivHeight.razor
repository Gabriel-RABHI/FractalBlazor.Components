@namespace  FractalBlazor.Components.Layout

@using Microsoft.JSInterop

@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@TargetId" style="@ComputedStyle" class="@Classes">
    @ChildContent
</div>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string TargetId { get; set; }

    [Parameter]
    public int Gap { get; set; }

    [Parameter]
    public bool InModal { get; set; }

    [Parameter]
    public bool HideScrollbar { get; set; }

    [Parameter]
    public double PaddingBottomRem { get; set; } = 1.2;

    [Parameter]
    public int IntervalDelay { get; set; } = 1000;

    [Parameter]
    public string Style { get; set; }

    [Parameter]
    public string Classes { get; set; }

    private string ComputedStyle
    {
        get
        {
            var baseStyle = $"overflow-y:scroll; scroll-behavior: smooth; {Style}";
            if (HideScrollbar)
                baseStyle += " overflow: hidden;";

            return baseStyle;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("runTinyAdaptDivHeightInterval", new object[] { TargetId, Gap, PaddingBottomRem, InModal, IntervalDelay });
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("stopTinyAdaptDivHeightInterval", new object[] { TargetId });
        }
        catch (JSDisconnectedException ex)
        { }
    }

}
