@inherits TinyText

@if (Bold)
{
    <div class="@ComputedTextClasses" style="@ComputedBaseStyle"><b>@ChildContent</b></div>
}
else
{
    <div class="@ComputedTextClasses" style="@ComputedBaseStyle">@ChildContent</div>
}

@code {
    public TinyLabel()
    {
        base.Scale = TinyTextScale.Label;
    }
}
