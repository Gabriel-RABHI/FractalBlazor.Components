@namespace  FractalBlazor.Components.Layout
@inherits TinyComponentBase

@if (Bold)
{
    <div class="@ComputedTextClasses" style="@ComputedBaseStyle"><b>@ChildContent</b></div>
} else
{
    <div class="@ComputedTextClasses" style="@ComputedBaseStyle">@ChildContent</div>
}

@code {
    private TinyTextScale _scale = TinyTextScale.Text;
    private TinyTextSize _size = TinyTextSize.M;
    private TinyTextType _type = TinyTextType.None;
    private bool _bold = false;
    private bool _noWrap = false;
    private bool _required = false;

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    // -------------- TinyText Scale ------------ //
    protected TinyTextScale Scale { get => _scale; set => _scale = value; }

    private string TextScaleString
    {
        get
        {
            switch (_scale)
            {
                case TinyTextScale.Title:
                    return "tiny-title";
                case TinyTextScale.Subtitle:
                    return "tiny-subtitle";
                case TinyTextScale.Label:
                    return "tiny-label";
                case TinyTextScale.Text:
                    return "tiny-text";
            }
            return "";
        }
    }

    // -------------- TinyText Size ------------ //
    [Parameter]
    public bool L
    {
        get => _size == TinyTextSize.L;
        set
        {
            if (value) _size = TinyTextSize.L;
        }
    }

    [Parameter]
    public bool M
    {
        get => _size == TinyTextSize.M;
        set
        {
            if (value) _size = TinyTextSize.M;
        }
    }

    [Parameter]
    public bool S
    {
        get => _size == TinyTextSize.S;
        set
        {
            if (value) _size = TinyTextSize.S;
        }
    }

    [Parameter]
    public bool Bold {
        get => _bold;
        set => _bold = value;
    }

    private string TextSizeString
    {
        get
        {
            switch (_size)
            {
                case TinyTextSize.L:
                    return $"{TextScaleString}-l";
                case TinyTextSize.M:
                    return $"{TextScaleString}-m";
                case TinyTextSize.S:
                    return $"{TextScaleString}-s";
            }
            return "";
        }
    }

    // -------------- TinyText Type ------------ //
    [Parameter]
    public bool Success
    {
        get => _type == TinyTextType.Success;
        set
        {
            if (value) _type = TinyTextType.Success;
        }
    }

    [Parameter]
    public bool Warning
    {
        get => _type == TinyTextType.Warning;
        set
        {
            if (value) _type = TinyTextType.Warning;
        }
    }

    [Parameter]
    public bool Error
    {
        get => _type == TinyTextType.Error;
        set
        {
            if (value) _type = TinyTextType.Error;
        }
    }

    [Parameter]
    public bool Required
    {
        get => _required;
        set => _required = value;
    }

    [Parameter]
    public bool NoWrap
    {
        get => _noWrap;
        set => _noWrap = true;
    }

    [Parameter]
    public bool Wrap
    {
        get => !_noWrap;
        set => _noWrap = false;
    }

    private string TextTypeString
    {
        get
        {
            switch (_type)
            {
                case TinyTextType.Success:
                    return "tiny-text-success";
                case TinyTextType.Warning:
                    return "tiny-text-warning";
                case TinyTextType.Error:
                    return "tiny-text-error";
            }
            return "";
        }
    }

    private string TypeClassString
    {
        get
        {
            return (_noWrap ? "tiny-text-no-wrap" : "") +
                   (_required ? "tiny-text-required" : "");
        }
    }

    protected string ComputedTextClasses
    {
        get
        {
            return $"{TextScaleString} {TextSizeString} {TextTypeString} {TypeClassString}"; ;
        }
    }
}
