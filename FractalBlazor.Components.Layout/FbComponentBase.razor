    /// <summary>
    /// Flex grow factor
    /// </summary>
    [Parameter]
    public int Flex
    {
        get => _state._flex;
        set
        {
            if (DisplayMode != BaseDisplayMode.Flex && DisplayMode != BaseDisplayMode.InlineFlex)
                IsFlex = true;
            _state._flex = value;
        }
    }

    [Parameter]
    public bool FlexS { get => Flex == FbPresets.S_Flex; set => Flex = FbPresets.S_Flex; }

    [Parameter]
    public bool FlexM { get => Flex == FbPresets.M_Flex; set => Flex = FbPresets.M_Flex; }

    [Parameter]
    public bool FlexL { get => Flex == FbPresets.L_Flex; set => Flex = FbPresets.L_Flex; }

    [Parameter]
    public bool FlexX { get => Flex == FbPresets.X_Flex; set => Flex = FbPresets.X_Flex; }

    [Parameter]
    public bool FlexXX { get => Flex == FbPresets.XX_Flex; set => Flex = FbPresets.XX_Flex; }

    /// <summary>
    /// Disable flex grow/shrink
    /// </summary>
    [Parameter]
    public bool NoFlex
    {
        get => _state._flex == int.MinValue;
        set { _state._flex = int.MinValue; }
    }

    /// <summary>
    /// Flex basis width
    /// </summary>
    [Parameter]
    public string WidthBasis
    {
        get => _widthBasis;
        set
        {
            _widthBasis = value;
            if (!string.IsNullOrWhiteSpace(_widthBasis))
                _state._flex = int.MinValue;
        }
    }

