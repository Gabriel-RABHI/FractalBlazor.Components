        set => _state._noWrap = true;
    }

    /// <summary>
    /// Enable text wrap
    /// </summary>
    [Parameter]
    public bool TextWrap
    {
        get => !_state._noWrap;
        set => _state._noWrap = false;
    }

    protected string WrapClassString
    {
        get
        {
            if (_state._noWrap)
                return "fb-text-no-wrap";
            return "";
        }
    }

