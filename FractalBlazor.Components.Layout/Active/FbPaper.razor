@namespace  FractalBlazor.Components.Layout

@inherits FbComponentBase

<div cpnt="paper[@(StoreId)]" style="@ComputedStyle" class="@Classes">
    @ChildContent
</div>

@code {
    private string _shSmall = "0px 3px 1px -2px rgba(0,0,0,0.2),0px 2px 2px 0px rgba(0,0,0,0.14),0px 1px 5px 0px rgba(0,0,0,0.12)";
    private string _shNormal = "0px 2px 4px -1px rgba(0,0,0,0.2),0px 4px 5px 0px rgba(0,0,0,0.14),0px 1px 10px 0px rgba(0,0,0,0.12)";
    private string _shLarge = "0px 6px 6px -3px rgba(0,0,0,0.2),0px 10px 14px 1px rgba(0,0,0,0.14),0px 4px 18px 3px rgba(0,0,0,0.12)";

    private string ComputedStyle
    {
        get
        {
            return  ComputedBaseStyle +
                    (Gutter ? $"padding-left:1rem;padding-right:1rem;" : "") +
                    "background:#FFF;" +
                    (Rounded ? "border-radius:.25rem;" : "") +
                    (Border ? "border:1px solid #8888882F;" : "") +
                    (SmallShadow ? $"box-shadow:{_shSmall};" : "") +
                    (Shadow ? $"box-shadow:{_shNormal};" : "") +
                    (LargeShadow ? $"box-shadow:{_shLarge};" : "");
        }
    }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public bool Gutter { get; set; } = false;
    
    [Parameter]
    public bool Border { get; set; } = false;
    
    [Parameter]
    public bool Rounded { get; set; } = false;

    
    [Parameter]
    public bool SmallShadow { get; set; } = false;
    
    [Parameter]
    public bool Shadow { get; set; } = false;
    
    [Parameter]
    public bool LargeShadow { get; set; } = false;
}
