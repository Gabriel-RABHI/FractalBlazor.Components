@namespace  FractalBlazor.Components.Layout

@inherits TinyComponentBase

<TinyStack StoreId="TabPage-1" Classes="@(Classes + " tiny-text-m")" Style="@Style">
    <TinyRow StoreId="TabPage-2" JustifyCenter GM>
        @ChildContent
    </TinyRow>
    @if (BottomBorder)
    {
        <TinyHR Large></TinyHR>
    }
</TinyStack>

 @code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public bool BottomBorder { get; set; } = true;
}
