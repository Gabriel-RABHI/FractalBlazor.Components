@namespace  FractalBlazor.Components.Layout

<TinyRow StoreId="TabItem" NoFlex P8 G3 PL16 PR16 JustifyCenter Style="@((Enabled?"":"opacity:.5;") + (Selected?$"margin-bottom:-3px;border-bottom:2px {TinyBlazorUtilitiesBaseColors.Highlight} solid; color:{TinyBlazorUtilitiesBaseColors.Highlight};":"margin-bottom:-2px;") + "height:2.75rem;")" Classes="tiny-hover" OnClick=@OnClick>
    @ChildContent
</TinyRow>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }
    
    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public bool Enabled { get; set; } = true;
    
    [Parameter]
    public bool Selected { get; set; } = false;
}
