@namespace  FractalBlazor.Components.Layout

@inherits TinyFlexBoxBase

<div style=@ComputedStyle class="@Classes">
    @ChildContent
</div>

@code {

    [Parameter]
    public TinyFlexWrap Wrap { get => base.Wrap; set => base.Wrap = value; }

    [Parameter]
    public bool NoWrap { get => base.Wrap == TinyFlexWrap.NoWrap; set => base.Wrap = TinyFlexWrap.NoWrap; }

    [Parameter]
    public bool DoWrap { get => base.Wrap == TinyFlexWrap.Wrap; set => base.Wrap = TinyFlexWrap.Wrap; }

    [Parameter]
    public bool WrapReverse { get => base.Wrap == TinyFlexWrap.WrapReverse; set => base.Wrap = TinyFlexWrap.WrapReverse; }

    // -------------- TinyFlexDirection ------------ //
    [Parameter]
    public TinyFlexDirection Direction { get => base.Direction; set => base.Direction = value; }
    
    [Parameter]
    public bool DirectionRow { get => base.Direction == TinyFlexDirection.Row; set => base.Direction = TinyFlexDirection.Row; }
    
    [Parameter]
    public bool DirectionRowReverse { get => base.Direction == TinyFlexDirection.RowReverse; set => base.Direction = TinyFlexDirection.RowReverse; }
    
    [Parameter]
    public bool DirectionColumn { get => base.Direction == TinyFlexDirection.Column; set => base.Direction = TinyFlexDirection.Column; }
    
    [Parameter]
    public bool DirectionColumnReverse { get => base.Direction == TinyFlexDirection.ColumnReverse; set => base.Direction = TinyFlexDirection.ColumnReverse; }

    // -------------- TinyFlexJustify ------------ //
    [Parameter]
    public TinyFlexJustify Justify { get => base.Justify; set => base.Justify = value; }

    [Parameter]
    public bool JustifyStart { get => base.Justify == TinyFlexJustify.Start; set => base.Justify = TinyFlexJustify.Start; }

    [Parameter]
    public bool JustifyEnd { get => base.Justify == TinyFlexJustify.End; set => base.Justify = TinyFlexJustify.End; }

    [Parameter]
    public bool JustifyCenter { get => base.Justify == TinyFlexJustify.Center; set => base.Justify = TinyFlexJustify.Center; }

    [Parameter]
    public bool JustifyStretch { get => base.Justify == TinyFlexJustify.Stretch; set => base.Justify = TinyFlexJustify.Stretch; }

    [Parameter]
    public bool JustifySpaceBetwen { get => base.Justify == TinyFlexJustify.SpaceBetween; set => base.Justify = TinyFlexJustify.SpaceBetween; }

    [Parameter]
    public bool JustifySpaceAround { get => base.Justify == TinyFlexJustify.SpaceAround; set => base.Justify = TinyFlexJustify.SpaceAround; }

    [Parameter]
    public bool JustifyEvenly { get => base.Justify == TinyFlexJustify.Evenly; set => base.Justify = TinyFlexJustify.Evenly; }

    // -------------- TinyFlexAlignItems ------------ //
    [Parameter]
    public TinyFlexAlignItems AlignItems { get => base.AlignItems; set => base.AlignItems = value; }

    [Parameter]
    public bool AlignItemsStart { get => base.AlignItems == TinyFlexAlignItems.Start; set => base.AlignItems = TinyFlexAlignItems.Start; }

    [Parameter]
    public bool AlignItemsEnd { get => base.AlignItems == TinyFlexAlignItems.End; set => base.AlignItems = TinyFlexAlignItems.End; }

    [Parameter]
    public bool AlignItemsCenter { get => base.AlignItems == TinyFlexAlignItems.Center; set => base.AlignItems = TinyFlexAlignItems.Center; }

    [Parameter]
    public bool AlignItemsBaseline { get => base.AlignItems == TinyFlexAlignItems.Baseline; set => base.AlignItems = TinyFlexAlignItems.Baseline; }

    [Parameter]
    public bool AlignItemsStretch { get => base.AlignItems == TinyFlexAlignItems.Stretch; set => base.AlignItems = TinyFlexAlignItems.Stretch; }

    // -------------- TinyFlexAlignContent ------------ //
    [Parameter]
    public TinyFlexAlignContent AlignContent { get => base.AlignContent; set => base.AlignContent = value; }

    [Parameter]
    public bool AlignContentStart { get => base.AlignContent == TinyFlexAlignContent.Start; set => base.AlignContent = TinyFlexAlignContent.Start; }

    [Parameter]
    public bool AlignContentEnd { get => base.AlignContent == TinyFlexAlignContent.End; set => base.AlignContent = TinyFlexAlignContent.End; }

    [Parameter]
    public bool AlignContentCenter { get => base.AlignContent == TinyFlexAlignContent.Center; set => base.AlignContent = TinyFlexAlignContent.Center; }

    [Parameter]
    public bool AlignContentSpaceBetwen { get => base.AlignContent == TinyFlexAlignContent.SpaceBetween; set => base.AlignContent = TinyFlexAlignContent.SpaceBetween; }

    [Parameter]
    public bool AlignContentSpaceAround { get => base.AlignContent == TinyFlexAlignContent.SpaceAround; set => base.AlignContent = TinyFlexAlignContent.SpaceAround; }

    [Parameter]
    public bool AlignContentStretch { get => base.AlignContent == TinyFlexAlignContent.Stretch; set => base.AlignContent = TinyFlexAlignContent.Stretch; }
}
