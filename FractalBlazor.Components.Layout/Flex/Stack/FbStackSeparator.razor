@namespace  FractalBlazor.Components.Layout

@using System.Diagnostics

<div cpnt="stack-separator" style="@($"display: flex; align-self: stretch;" + (Margin != FbMargin.None ? $"margin-top:{MarginSize}rem;margin-bottom:{MarginSize}rem;" : ""))" class="@ComputedStackSeparatorClasses"></div>

@code {
    #region HIDDEN
    private FbFrame _frame = FbFrame.Medium;

    private string MarginSize => ((double)((int)Margin) / 16d).ToString().Replace(",", ".");

    // -------------- FbStackSeparator Frame ------------ //
    protected FbFrame Frame { get => _frame; set => _frame = value; }

    protected string ComputedStackSeparatorClasses
    {
        get
        {
            return $"{FrameClass}";
        }
    }

    private string FrameClass {
        get {
            string baseClasse = "fb-separator";

            if (_frame is FbFrame.Small)
                return $"{baseClasse}-small-frame";
            else if (_frame is FbFrame.Medium)
                return $"{baseClasse}-medium-frame";
            else if (_frame is FbFrame.Large)
                return $"{baseClasse}-large-frame";
            else
                return "";
        }
    }
    #endregion
    // ************************************************************************************************ //
    // ***************************************    PUBLIC   ******************************************** //
    // ************************************************************************************************ //
    /// <summary>
    /// Frame -> Small
    /// </summary>
    [Parameter]
    public bool WSFrame { get => Frame == FbFrame.Small; set => Frame = FbFrame.Small; }

    /// <summary>
    /// Frame -> Medium
    /// </summary>
    [Parameter]
    public bool WMFrame { get => Frame == FbFrame.Medium; set => Frame = FbFrame.Medium; }

    /// <summary>
    /// Frame -> Large
    /// </summary>
    [Parameter]
    public bool WLFrame { get => Frame == FbFrame.Large; set => Frame = FbFrame.Large; }

    /// <summary>
    /// Margin size
    /// </summary>
    [Parameter]
    public FbMargin Margin
    {
        get; set; 
    }

    /// <summary>
    /// Margin -> 0
    /// </summary>
    [Parameter]
    public bool M0 { get => Margin == FbMargin.Margin_0; set => Margin = FbMargin.Margin_0; }

    /// <summary>
    /// Margin -> 1
    /// </summary>
    [Parameter]
    public bool M1 { get => Margin == FbMargin.Margin_1; set => Margin = FbMargin.Margin_1; }

    /// <summary>
    /// Margin -> 2
    /// </summary>
    [Parameter]
    public bool M2 { get => Margin == FbMargin.Margin_2; set => Margin = FbMargin.Margin_2; }

    /// <summary>
    /// Margin -> 3
    /// </summary>
    [Parameter]
    public bool M3 { get => Margin == FbMargin.Margin_3; set => Margin = FbMargin.Margin_3; }

    /// <summary>
    /// Margin -> 4
    /// </summary>
    [Parameter]
    public bool M4 { get => Margin == FbMargin.Margin_4; set => Margin = FbMargin.Margin_4; }

    /// <summary>
    /// Margin -> 8
    /// </summary>
    [Parameter]
    public bool M8 { get => Margin == FbMargin.Margin_8; set => Margin = FbMargin.Margin_8; }

    /// <summary>
    /// Margin -> 12
    /// </summary>
    [Parameter]
    public bool M12 { get => Margin == FbMargin.Margin_12; set => Margin = FbMargin.Margin_12; }

    /// <summary>
    /// Margin -> 16
    /// </summary>
    [Parameter]
    public bool M16 { get => Margin == FbMargin.Margin_16; set => Margin = FbMargin.Margin_16; }

    /// <summary>
    /// Margin -> 24
    /// </summary>
    [Parameter]
    public bool M24 { get => Margin == FbMargin.Margin_24; set => Margin = FbMargin.Margin_24; }

    /// <summary>
    /// Margin -> 32
    /// </summary>
    [Parameter]
    public bool M32 { get => Margin == FbMargin.Margin_32; set => Margin = FbMargin.Margin_32; }

    /// <summary>
    /// Margin -> 40
    /// </summary>
    [Parameter]
    public bool M40 { get => Margin == FbMargin.Margin_40; set => Margin = FbMargin.Margin_40; }

    /// <summary>
    /// Margin -> 48
    /// </summary>
    [Parameter]
    public bool M48 { get => Margin == FbMargin.Margin_48; set => Margin = FbMargin.Margin_48; }

    /// <summary>
    /// Margin -> Small
    /// </summary>
    [Parameter]
    public bool MS { get => Margin == FbMargin.Margin_8; set => Margin = FbMargin.Margin_8; }

    /// <summary>
    /// Margin -> Medium
    /// </summary>
    [Parameter]
    public bool MM { get => Margin == FbMargin.Margin_12; set => Margin = FbMargin.Margin_12; }

    /// <summary>
    /// Margin -> Large
    /// </summary>
    [Parameter]
    public bool ML { get => Margin == FbMargin.Margin_24; set => Margin = FbMargin.Margin_24; }
}
