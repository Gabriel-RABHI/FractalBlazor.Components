@namespace  FractalBlazor.Components.Layout

<div cpnt="stack-break" style="width:0px; height:100%;" class="@ClassName"></div>

@code {

    private string ClassName
    {
        get
        {
            switch (Break)
            {
                case TinyBreaks.XXS_480px:
                    return Under ? "column-break-under-xxs" : "column-break-over-xxs";
                case TinyBreaks.XS_600px:
                    return Under ? "column-break-under-xs" : "column-break-over-xs";
                case TinyBreaks.S_960px:
                    return Under ? "column-break-under-s" : "column-break-over-s";
                case TinyBreaks.M_1280px:
                    return Under ? "column-break-under-m" : "column-break-over-m";
                case TinyBreaks.L_1600px:
                    return Under ? "column-break-under-l" : "column-break-over-l";
                case TinyBreaks.XL_1960px:
                    return Under ? "column-break-under-xl" : "column-break-over-xl";
            }
            return "break-column-under-s";
        }
    }

    // ************************************************************************************************ //
    // ***************************************    PUBLIC   ******************************************** //
    // ************************************************************************************************ //

    [Parameter]
    public TinyBreaks Break { get; set; } = TinyBreaks.S_960px;

    [Parameter]
    public bool XXS { get => Break == TinyBreaks.XXS_480px; set => Break = TinyBreaks.XXS_480px; }

    [Parameter]
    public bool XS { get => Break == TinyBreaks.XS_600px; set => Break = TinyBreaks.XS_600px; }

    [Parameter]
    public bool S { get => Break == TinyBreaks.S_960px; set => Break = TinyBreaks.S_960px; }

    [Parameter]
    public bool M { get => Break == TinyBreaks.M_1280px; set => Break = TinyBreaks.M_1280px; }

    [Parameter]
    public bool L { get => Break == TinyBreaks.L_1600px; set => Break = TinyBreaks.L_1600px; }

    [Parameter]
    public bool XL { get => Break == TinyBreaks.XL_1960px; set => Break = TinyBreaks.XL_1960px; }

    [Parameter]
    public bool Under { get; set; } = true;
    
    [Parameter]
    public bool Over { get => !Under; set=>Under=!value; }
}
