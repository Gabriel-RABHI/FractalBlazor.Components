@namespace  FractalBlazor.Components.Layout

@inherits FbFlexBoxBase

@switch (MasterSlaveStatus)
{
    case FbFlexMasterSlave.None:
        <div cpnt="row[@(StoreId)]" style=@ComputedStyle class="fb-row @ComputedRowClasses" @onclick=@(() => OnClick.InvokeAsync())>
            @*<div style="height:100%;"><img src="FbBlazor/row-icon.png")" /></div>*@
            @ChildContent
        </div>
        break;
    case FbFlexMasterSlave.Master:
        <div cpnt="row[@(StoreId)]" style=@ComputedStyle class="fb-row @ComputedRowClasses" @onclick=@(() => OnClick.InvokeAsync()) data-fb-width-master-id="@WidthMasterId">
            @ChildContent
        </div>
        break;
    case FbFlexMasterSlave.Slave:
        <div cpnt="row[@(StoreId)]" style=@ComputedStyle class="fb-row @ComputedRowClasses" @onclick=@(() => OnClick.InvokeAsync()) data-fb-width-slave-id="@WidthSlaveId">
            @ChildContent
        </div>
        break;
}

@code {
    private FbFrame _frame = FbFrame.None;
    private FbFrame _separator = FbFrame.None;
    private FbBackground _background = FbBackground.None;

    protected FbFrame Frame { get => _frame; set => _frame = value; }

    protected FbFrame Separator { get => _separator; set => _separator = value; }

    protected FbBackground Background { get => _background; set => _background = value; }

    public FbRow()
    {
        Direction = FbFlexDirection.Row;
        SingleLine = true;
        JHSt = true;
        IsFlex = true;
        Flex = 1;
    }

    private string FrameClass
    {
        get
        {
            string baseClasse = "framed-row";

            if (_frame is FbFrame.Small)
                return $"{baseClasse} {baseClasse}-small-frame";
            else if (_frame is FbFrame.Medium)
                return $"{baseClasse} {baseClasse}-medium-frame";
            else if (_frame is FbFrame.Large)
                return $"{baseClasse} {baseClasse}-large-frame";
            else
                return "";
        }
    }

    private string SeparatorClass
    {
        get
        {
            string baseClasse = "framed-separator-row";

            if (_separator is FbFrame.Small)
                return $"{baseClasse} {baseClasse}-small-frame";
            else if (_separator is FbFrame.Medium)
                return $"{baseClasse} {baseClasse}-medium-frame";
            else if (_separator is FbFrame.Large)
                return $"{baseClasse} {baseClasse}-large-frame";
            else
                return "";
        }
    }

    private string ComputedFrameClasses
    {
        get
        {
            if (FrameClass != "" || SeparatorClass != "")
                return $"{FrameClass} {SeparatorClass}";
            return "";
        }
    }

    private string BackgroundClasses
    {
        get
        {
            switch (_background)
            {
                case FbBackground.Default:
                    return "fb-white-background";
                case FbBackground.Accent:
                    return "fb-header-background";
                case FbBackground.Highlight:
                    return "fb-sellect-background";
            }
            return "";
        }
    }

    protected string ComputedRowClasses
    {
        get
        {
            return $"{Classes} {ComputedFrameClasses} {BackgroundClasses} {WrapClassString} {ResponsiveClassString}";
        }
    }

    // -------------- FbFlexAlignContent ------------ //
    protected bool LinesOnTop { get => base.AlignContent == FbFlexAlignContent.Start; set => base.AlignContent = FbFlexAlignContent.Start; }

    protected bool LinesOnBottom { get => base.AlignContent == FbFlexAlignContent.End; set => base.AlignContent = FbFlexAlignContent.End; }

    protected bool LinesOnCenter { get => base.AlignContent == FbFlexAlignContent.Center; set => base.AlignContent = FbFlexAlignContent.Center; }

    protected bool LinesWithSpaceBetwen { get => base.AlignContent == FbFlexAlignContent.SpaceBetween; set => base.AlignContent = FbFlexAlignContent.SpaceBetween; }

    protected bool LinesWithSpaceAround { get => base.AlignContent == FbFlexAlignContent.SpaceAround; set => base.AlignContent = FbFlexAlignContent.SpaceAround; }

    protected bool LinesStretched { get => base.AlignContent == FbFlexAlignContent.Stretch; set => base.AlignContent = FbFlexAlignContent.Stretch; }

    protected BaseDisplayMode DisplayMode { get => base.DisplayMode; set => base.DisplayMode = value; }

    // ************************************************************************************************ //
    // ***************************************    PUBLIC   ******************************************** //
    // ************************************************************************************************ //
    [Parameter]
    public EventCallback OnClick { get; set; }

    // -------- MISSING --------- //
    [Parameter]
    public string MinWidth { get => base.MinWidth; set => base.MinWidth = value; }

    [Parameter]
    public string MinHeight { get => base.MinHeight; set => base.MinHeight = value; }

    [Parameter]
    public string MaxHeight { get => base.MaxHeight; set => base.MaxHeight = value; }

    // -------- MISSING --------- //

    [Parameter]
    public bool Reverse
    {
        get => Direction == FbFlexDirection.RowReverse;
        set
        {
            if (value)
                Direction = FbFlexDirection.RowReverse;
            else Direction = FbFlexDirection.Row;
        }
    }

    [Parameter]
    public bool SingleLine { get => base.Wrap == FbFlexWrap.NoWrap; set => base.Wrap = FbFlexWrap.NoWrap; }

    [Parameter]
    public bool MultiLine { get => base.Wrap == FbFlexWrap.Wrap; set => base.Wrap = FbFlexWrap.Wrap; }

    [Parameter]
    public bool ReverseMultiLine { get => base.Wrap == FbFlexWrap.WrapReverse; set => base.Wrap = FbFlexWrap.WrapReverse; }

    // -------------- FbFlexJustify ------------ //
    [Parameter]
    public bool JS { get => JHS && JVS; set => JHS = JVS = true; }

    [Parameter]
    public bool JE { get => JHE && JVE; set => JHE = JVE = true; }

    [Parameter]
    public bool JC { get => JHC && JVC; set => JHC = JVC = true; }

    [Parameter]
    public bool JSt { get => JHSt && JVSt; set => JHSt = JVSt = true; }

    // -------------- FbFlexJustify ------------ //
    [Parameter]
    public bool JHS { get => base.Justify == FbFlexJustify.Start; set => base.Justify = FbFlexJustify.Start; }

    [Parameter]
    public bool JHE { get => base.Justify == FbFlexJustify.End; set => base.Justify = FbFlexJustify.End; }

    /// <summary>
    /// Justify Horizontal Center
    /// </summary>
    [Parameter]
    public bool JHC { get => base.Justify == FbFlexJustify.Center; set => base.Justify = FbFlexJustify.Center; }

    [Parameter]
    public bool JHSt { get => base.Justify == FbFlexJustify.Stretch; set => base.Justify = FbFlexJustify.Stretch; }

    [Parameter]
    public bool JHSB { get => base.Justify == FbFlexJustify.SpaceBetween; set => base.Justify = FbFlexJustify.SpaceBetween; }

    [Parameter]
    public bool JHSA { get => base.Justify == FbFlexJustify.SpaceAround; set => base.Justify = FbFlexJustify.SpaceAround; }

    [Parameter]
    public bool JHEv { get => base.Justify == FbFlexJustify.Evenly; set => base.Justify = FbFlexJustify.Evenly; }

    // -------------- FbFlexAlignItems ------------ //
    [Parameter]
    public bool JVS { get => base.AlignItems == FbFlexAlignItems.Start; set => base.AlignItems = FbFlexAlignItems.Start; }

    [Parameter]
    public bool JVE { get => base.AlignItems == FbFlexAlignItems.End; set => base.AlignItems = FbFlexAlignItems.End; }

    [Parameter]
    public bool JVC { get => base.AlignItems == FbFlexAlignItems.Center; set => base.AlignItems = FbFlexAlignItems.Center; }

    [Parameter]
    public bool JVBl { get => base.AlignItems == FbFlexAlignItems.Baseline; set => base.AlignItems = FbFlexAlignItems.Baseline; }

    [Parameter]
    public bool JVSt { get => base.AlignItems == FbFlexAlignItems.Stretch; set => base.AlignItems = FbFlexAlignItems.Stretch; }

    // -------------- FbRow Frame ------------ //
    [Parameter]
    public bool WSFrame { get => Frame == FbFrame.Small; set => Frame = FbFrame.Small; }

    [Parameter]
    public bool WMFrame { get => Frame == FbFrame.Medium; set => Frame = FbFrame.Medium; }

    [Parameter]
    public bool WLFrame { get => Frame == FbFrame.Large; set => Frame = FbFrame.Large; }

    [Parameter]
    public bool WSSeparator { get => Separator == FbFrame.Small; set => Separator = FbFrame.Small; }

    [Parameter]
    public bool WMSeparator { get => Separator == FbFrame.Medium; set => Separator = FbFrame.Medium; }

    [Parameter]
    public bool WLSeparator { get => Separator == FbFrame.Large; set => Separator = FbFrame.Large; }

    [Parameter]
    public bool WSGrid { get => WSFrame && WSSeparator; set => WSFrame = WSSeparator = true; }

    [Parameter]
    public bool WMGrid { get => WMFrame && WMSeparator; set => WMFrame = WMSeparator = true; }

    [Parameter]
    public bool WLGrid { get => WLFrame && WLSeparator; set => WLFrame = WLSeparator = true; }

    [Parameter]
    public bool WSR { get => Radius == FbSpacings.S_Radius; set => Radius = FbSpacings.S_Radius; }
    
    [Parameter]
    public bool WMR { get => Radius == FbSpacings.M_Radius; set => Radius = FbSpacings.M_Radius; }
    
    [Parameter]
    public bool WLR { get => Radius == FbSpacings.L_Radius; set => Radius = FbSpacings.L_Radius; }
    
    [Parameter]
    public bool WXR { get => Radius == FbSpacings.X_Radius; set => Radius = FbSpacings.X_Radius; }

    [Parameter]
    public bool WDefaultBackground { get => _background == FbBackground.Default; set => _background = FbBackground.Default; }

    [Parameter]
    public bool WAccentBackground { get => _background == FbBackground.Accent; set => _background = FbBackground.Accent; }

    [Parameter]
    public bool WHighlightBackground { get => _background == FbBackground.Highlight; set => _background = FbBackground.Highlight; }
}
