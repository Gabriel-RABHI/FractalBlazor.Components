@inherits FbFlexBoxBase

<div cpnt="column[@(StoreId)]" style="@ComputedStyle" class="fb-column @ComputedColumnClasses">
    @ChildContent
</div>

@code {
    public FbColumn()
    {
        ColumnDisplay = true;
        AlignItems = FbFlexAlignItems.Stretch;
        Flex = 1;
    }

    protected string ComputedColumnClasses
    {
        get
        {
            return $"{Classes} {WrapClassString} {ResponsiveClassString}";
        }
    }

    // ************************************************************************************************ //
    // ***************************************    PUBLIC   ******************************************** //
    // ************************************************************************************************ //

    // -------- MISSING --------- //
    /// <summary>
    /// Minimum width
    /// </summary>
    [Parameter]
    public string MinWidth { get => base.MinWidth; set => base.MinWidth = value; }

    /// <summary>
    /// Minimum height
    /// </summary>
    [Parameter]
    public string MinHeight { get => base.MinHeight; set => base.MinHeight = value; }

    /// <summary>
    /// Maximum height
    /// </summary>
    [Parameter]
    public string MaxHeight { get => base.MaxHeight; set => base.MaxHeight = value; }

    // -------- MISSING --------- //
}

