@inherits TinyFlexBoxBase

<div cpnt="column[@(StoreId)]" style="@ComputedStyle" class="tiny-column @ComputedColumnClasses">
    @ChildContent
</div>

@code {
    public TinyColumn()
    {
        ColumnDisplay = true;
        AlignItems = TinyFlexAlignItems.Stretch;
        Flex = 1;
    }

    protected string ComputedColumnClasses
    {
        get
        {
            return $"{Classes} {DesignClass} {WrapClassString} {ResponsiveClassString}";
        }
    }

    private string DesignClass
    {
        get
        {
            if (Design)
                return "tiny-design";
            else
                return "";
        }
    }

    // ************************************************************************************************ //
    // ***************************************    PUBLIC   ******************************************** //
    // ************************************************************************************************ //

    // -------- MISSING --------- //
    [Parameter]
    public string MinWidth { get => base.MinWidth; set => base.MinWidth = value; }

    [Parameter]
    public string MinHeight { get => base.MinHeight; set => base.MinHeight = value; }

    [Parameter]
    public string MaxHeight { get => base.MaxHeight; set => base.MaxHeight = value; }

    [Parameter]
    public bool Design { get; set; }

    // -------- MISSING --------- //
}

