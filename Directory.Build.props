<Project>

  <!-- Package metadata shared by the libraries. Projects that are not libraries set IsPackable to false. -->
  <PropertyGroup>
    <Authors>Gabriel RABHI</Authors>
    <Copyright>Copyright (c) 2026 Gabriel RABHI</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Gabriel-RABHI/FractalBlazor.Components</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Gabriel-RABHI/FractalBlazor.Components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor;components;layout;theming;design-tokens;css-variables</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview</VersionSuffix>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
