@* A task of the board: a draggable that is also a receiver, split into top, center and
   bottom. Its actions show over its corners when it is hovered (FbShowWhenOver), so the
   title takes the whole width; its body is its handle. Its subtasks are views of their own
   states, nested draggables and receivers. *@
@attribute [ViewFor<ViewSelector>(typeof(KanbanTaskState), ViewSelector.Viewer)]

<FbDraggable DragId="@Item">
    <FbDraggableReceiver DropId="@Item" ZTCB WBS WFL WRM>
        <FbStack NoFlex JVS>
            @if (Item.Editing)
            {
                <FbShowWhenOver Fixed Offsets="-12px">
                    <TopLeftContent>
                        <FbDraggableHandle>
                            <FbRow NoFlex PS WBA WFM WRM><FbIcon Icon="@FbMaterialIcons.DragIndicator" S /></FbRow>
                        </FbDraggableHandle>
                    </TopLeftContent>
                    <TopRightContent>
                        <FbButton KP PS Variant="@FbThemeVariants.Success" Handler="Item" Action="@ToggleEdit" Title="Valider">
                            <FbIcon Icon="@FbMaterialIcons.Check" S />
                        </FbButton>
                    </TopRightContent>
                    <ChildContent>
                        <FbStack NoFlex GS PM PTL JVS>
                            <FbInputText TAction="KanbanNode.SetTitle" Handler="Item" Value="@Item.Title" Immediate Placeholder="Titre" />
                            <FbInputText TAction="KanbanTaskState.SetDetails" Handler="Item" Value="@Item.Details" Immediate Placeholder="Détails" />
                        </FbStack>
                    </ChildContent>
                </FbShowWhenOver>
            }
            else
            {
                <FbShowWhenOver Offsets="-12px">
                    <TopLeftContent>
                        @if (!Item.HasSubTasks)
                        {
                            <FbButton KP PS Variant="@(Item.Done ? FbThemeVariants.Success : FbThemeVariants.Info)"
                                      Handler="Item" Action="@ToggleDone" Title="@(Item.Done ? "Marquer à faire" : "Marquer faite")">
                                <FbIcon Icon="@(Item.Done ? FbMaterialIcons.CheckBox : FbMaterialIcons.CheckBoxOutlineBlank)" S />
                            </FbButton>
                        }
                    </TopLeftContent>
                    <TopRightContent>
                        <FbRow NoFlex GS>
                            <FbButton KP PS Variant="@FbThemeVariants.Error" Handler="Item" Action="@Delete" Title="Supprimer la tâche">
                                <FbIcon Icon="@FbMaterialIcons.Delete" S />
                            </FbButton>
                            <FbButton KP PS Variant="@FbThemeVariants.Selected" Handler="Item" Action="@ToggleEdit" Title="Modifier">
                                <FbIcon Icon="@FbMaterialIcons.Edit" S />
                            </FbButton>
                        </FbRow>
                    </TopRightContent>
                    <ChildContent>
                        <FbDraggableHandle>
                            <FbStack NoFlex GS PM PTL JVS>
                                @if (Item.HasSubTasks)
                                {
                                    <KanbanProgress Done="@Item.DoneCount" Total="@Item.LeafCount" />
                                }
                                <FbRow NoFlex GS JVS>
                                    @if (Item.Done)
                                    {
                                        <FbIcon Icon="@FbMaterialIcons.Check" S Variant="@FbThemeVariants.Success" />
                                    }
                                    <FbText S B Muted="@Item.Done">@Item.Title</FbText>
                                </FbRow>
                                @if (Item.Details.Length > 0)
                                {
                                    <FbText XS Muted>@Item.Details</FbText>
                                }
                            </FbStack>
                        </FbDraggableHandle>
                    </ChildContent>
                </FbShowWhenOver>
            }
            @if (Item.HasSubTasks)
            {
                <FbStack NoFlex GM PHM PBM JVS>
                    @foreach (var task in Item.Tasks)
                    {
                        <FbDynamicView @key="task" TSelector="ViewSelector" Item="task" Selector="ViewSelector.Viewer" />
                    }
                </FbStack>
            }
        </FbStack>
    </FbDraggableReceiver>
</FbDraggable>

@code {
    private static readonly KanbanNode.ToggleEdit ToggleEdit = new();
    private static readonly KanbanTaskState.ToggleDone ToggleDone = new();
    private static readonly KanbanTaskState.Delete Delete = new();

    [Parameter]
    public KanbanTaskState Item { get; set; } = default!;
}
