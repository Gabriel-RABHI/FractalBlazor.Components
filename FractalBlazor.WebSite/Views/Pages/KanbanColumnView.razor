@* A column of the board: a draggable that is also a receiver, split into left, center and
   right. Its actions show over its header when it is hovered (FbShowWhenOver), so the
   title takes the whole width; the header is its handle. Its tasks are views of their own
   states. *@
@attribute [ViewFor<ViewSelector>(typeof(KanbanColumnState), ViewSelector.Viewer)]

<FbDraggable DragId="@Item" Style="flex:none;width:18rem">
    <FbDraggableReceiver DropId="@Item" ZLCR PM WBA WRL>
        <FbStack NoFlex GM JVS>
            @if (Item.Editing)
            {
                <FbShowWhenOver Fixed Offsets="-12px">
                    <TopLeftContent>
                        <FbDraggableHandle>
                            <FbRow NoFlex PS WBS WFM WRM><FbIcon Icon="@FbMaterialIcons.DragIndicator" S /></FbRow>
                        </FbDraggableHandle>
                    </TopLeftContent>
                    <TopRightContent>
                        <FbButton KP PS Variant="@FbThemeVariants.Success" Handler="Item" Action="@ToggleEdit" Title="Valider">
                            <FbIcon Icon="@FbMaterialIcons.Check" S />
                        </FbButton>
                    </TopRightContent>
                    <ChildContent>
                        <FbStack NoFlex GS PTL JVS>
                            <FbInputText TAction="KanbanNode.SetTitle" Handler="Item" Value="@Item.Title" Immediate Placeholder="Titre" />
                            <KanbanProgress Done="@Item.DoneCount" Total="@Item.LeafCount" />
                        </FbStack>
                    </ChildContent>
                </FbShowWhenOver>
            }
            else
            {
                <FbShowWhenOver Offsets="-12px">
                    <TopRightContent>
                        <FbRow NoFlex GS>
                            <FbButton KP PS Variant="@FbThemeVariants.Error" Handler="Item" Action="@Delete" Title="Supprimer la liste">
                                <FbIcon Icon="@FbMaterialIcons.Delete" S />
                            </FbButton>
                            <FbButton KP PS Variant="@FbThemeVariants.Selected" Handler="Item" Action="@ToggleEdit" Title="Renommer">
                                <FbIcon Icon="@FbMaterialIcons.Edit" S />
                            </FbButton>
                        </FbRow>
                    </TopRightContent>
                    <ChildContent>
                        <FbDraggableHandle>
                            <FbStack NoFlex GS JVS>
                                <FbRow NoFlex GS JVBl>
                                    <FbText M B>@Item.Title</FbText>
                                    <FbText S Muted>@Item.DoneCount / @Item.LeafCount</FbText>
                                </FbRow>
                                <KanbanProgress Done="@Item.DoneCount" Total="@Item.LeafCount" />
                            </FbStack>
                        </FbDraggableHandle>
                    </ChildContent>
                </FbShowWhenOver>
            }
            @foreach (var task in Item.Tasks)
            {
                <FbDynamicView @key="task" TSelector="ViewSelector" Item="task" Selector="ViewSelector.Viewer" />
            }
            <FbButton S KT Handler="Item" Action="@AddTask">
                <FbIcon Icon="@FbMaterialIcons.Add" S />
                <FbText S>Nouvelle tâche</FbText>
            </FbButton>
        </FbStack>
    </FbDraggableReceiver>
</FbDraggable>

@code {
    private static readonly KanbanNode.ToggleEdit ToggleEdit = new();
    private static readonly KanbanColumnState.Delete Delete = new();
    private static readonly KanbanColumnState.AddTask AddTask = new();

    [Parameter]
    public KanbanColumnState Item { get; set; } = default!;
}
