@* Sliders with dots and values, horizontal then vertical: the same four states, so that a
   thumb moved in one orientation moves in the other. *@
@attribute [ViewFor<ViewSelector>(typeof(DotsSliderDemoState), ViewSelector.Viewer)]

<FbVariant Variant="@FbThemeVariants.Info">
<FbStack NoFlex GX JVS>
    <FbStack NoFlex GX JVS>
        <FbSlider TValue="int" TAction="DotsSliderDemoState.SetRating" Handler="Item" Value="@Item.Rating"
                  Max="10" EL VL Title="Note" />
        <FbRangeSlider TValue="int" TAction="DotsSliderDemoState.SetSpan" Handler="Item" Value="@Item.Span"
                       EL VL Title="Étendue" />
        <FbSlider TValue="int" TAction="DotsSliderDemoState.SetStep" Handler="Item" Value="@Item.Step"
                  Max="10" Ticks="1" TD EL VL Title="Niveau" />
        <FbRangeSlider TValue="int" TAction="DotsSliderDemoState.SetSteps" Handler="Item" Value="@Item.Steps"
                       Max="10" Ticks="1" TD TL Mirror VL Title="Paliers" />
    </FbStack>
    <FbRow NoFlex MultiLine GX JHC JVSt MinHeight="16rem">
        <FbSlider TValue="int" TAction="DotsSliderDemoState.SetRating" Handler="Item" Value="@Item.Rating"
                  Vertical Max="10" EL VL Title="Note" />
        <FbRangeSlider TValue="int" TAction="DotsSliderDemoState.SetSpan" Handler="Item" Value="@Item.Span"
                       Vertical EL VL Title="Étendue" />
        <FbSlider TValue="int" TAction="DotsSliderDemoState.SetStep" Handler="Item" Value="@Item.Step"
                  Vertical Max="10" Ticks="1" TD EL VL Title="Niveau" />
        <FbRangeSlider TValue="int" TAction="DotsSliderDemoState.SetSteps" Handler="Item" Value="@Item.Steps"
                       Vertical Max="10" Ticks="1" TD TL VL Title="Paliers" />
    </FbRow>
</FbStack>
</FbVariant>

@code {
    [Parameter]
    public DotsSliderDemoState Item { get; set; } = default!;
}
