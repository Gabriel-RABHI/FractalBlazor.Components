@* The editor model lives in the circuit (a scoped service): the edited values, and the open
   tabs, survive navigation. It is also saved in the browser after every change and restored
   when the editor opens, so a reload, a lost circuit or a restart lose nothing. *@
@attribute [ViewFor<ViewSelector>(typeof(ThemeEditorPage), ViewSelector.Viewer)]
@inject IFbFormThemeRegistry Registry
@inject ThemeEditorModel Model
@inject ThemeEditorAutoSave AutoSave

@using FractalBlazor.WebSite.ThemeEditor
@using FractalBlazor.Components.Forms.Contracts
@using FractalBlazor.Components.Forms.Theming.Helpers
@using FractalBlazor.Components.Forms.Components.Icons

<FbStack GL>
    <FbText M Muted>
        Les réglages construisent un FbThemeSetup dérivé du thème par défaut. L’aperçu l’applique
        avec un FbTheme Scoped, sans toucher au reste de la page. Les espacements, les rayons et la
        typographie appartiennent au thème ; les couleurs et les mélanges, à chaque branche, qui garde
        ses réglages quand on passe de l’une à l’autre. Le code du thème déclare les deux.
    </FbText>

    <FbRow GS JVC MultiLine>
        <FbIcon Icon="@FbMaterialIcons.CloudDone" S Subtle />
        <FbText XS Muted>Tout est enregistré automatiquement dans ce navigateur.</FbText>
        <FbRowSpacer />
        @if (_confirmReset)
        {
            <FbText S>Effacer tous les réglages et repartir du thème par défaut ?</FbText>
            <FbButton Variant="@FbThemeVariants.Error" OnClick="ResetAll"><FbIcon Icon="@FbMaterialIcons.DeleteForever" /><FbText S>Effacer</FbText></FbButton>
            <FbButton WBN OnClick="() => _confirmReset = false"><FbText S>Annuler</FbText></FbButton>
        }
        else
        {
            <FbButton WBN OnClick="() => _confirmReset = true"><FbIcon Icon="@FbMaterialIcons.RestartAlt" /><FbText S>Repartir du thème par défaut</FbText></FbButton>
        }
    </FbRow>

    <FbTabs TAction="FbSetValue<int>" @bind-Value="Model.EditTab" Items="EditTabs" />

    @switch (Model.EditTab)
    {
        case 0:
            <FbGridContainer Columns="1" ColumnsM="2" GL JVS>
                <FbGridItem>
                    <FbStack GM PL WBA WFL WRL>
                        <FbText L B>Espacements</FbText>
                        <ValueSlider Label="S" Unit="rem" Max="4" Step="0.0625" @bind-Value="Model.SpaceS" />
                        <ValueSlider Label="M" Unit="rem" Max="4" Step="0.0625" @bind-Value="Model.SpaceM" />
                        <ValueSlider Label="L" Unit="rem" Max="4" Step="0.0625" @bind-Value="Model.SpaceL" />
                        <ValueSlider Label="X" Unit="rem" Max="4" Step="0.0625" @bind-Value="Model.SpaceX" />
                    </FbStack>
                </FbGridItem>
                <FbGridItem>
                    <FbStack GM PL WBA WFL WRL>
                        <FbText L B>Rayons</FbText>
                        <ValueSlider Label="S" Unit="rem" Max="2" Step="0.0625" @bind-Value="Model.RadiusS" />
                        <ValueSlider Label="M" Unit="rem" Max="2" Step="0.0625" @bind-Value="Model.RadiusM" />
                        <ValueSlider Label="L" Unit="rem" Max="2" Step="0.0625" @bind-Value="Model.RadiusL" />
                        <ValueSlider Label="X" Unit="rem" Max="2" Step="0.0625" @bind-Value="Model.RadiusX" />
                    </FbStack>
                </FbGridItem>
            </FbGridContainer>
            <FbRow JHE>
                <FbButton WBN OnClick="Model.ResetShape"><FbIcon Icon="@FbMaterialIcons.RestartAlt" /><FbText S>Réinitialiser les espacements et les rayons</FbText></FbButton>
            </FbRow>
            break;

        case 1:
            <FbGridContainer Columns="1" ColumnsM="2" ColumnsXL="3" GL JVS>
                <FbGridItem>
                    <FbStack GM PL WBA WFL WRL>
                        <FbText L B>Polices et tailles</FbText>
                        <FbInputText TAction="FbSetValue<string>" Value="@Model.TextFontFamily" ValueChanged="@(value => Model.TextFontFamily = value)">
                            <StartContent><FbRowItem Style="min-width:6.5rem"><FbText S Subtle>Texte</FbText></FbRowItem></StartContent>
                        </FbInputText>
                        <FbInputText TAction="FbSetValue<string>" Value="@Model.CodeFontFamily" ValueChanged="@(value => Model.CodeFontFamily = value)">
                            <StartContent><FbRowItem Style="min-width:6.5rem"><FbText S Subtle>Code</FbText></FbRowItem></StartContent>
                        </FbInputText>
                        <ValueSlider Label="Taille de base" Unit="px" Min="10" Max="24" Step="0.5" @bind-Value="Model.FontSize" />
                        <ValueSlider Label="Interligne" Unit="" Min="1" Max="2" Step="0.05" @bind-Value="Model.LineHeight" />
                    </FbStack>
                </FbGridItem>
                <FbGridItem>
                    <FbStack GM PL WBA WFL WRL>
                        <FbText L B>Familles par taille</FbText>
                        <FbText S Muted>Par défaut, chaque taille suit la police du texte : <FbText Code>var(--fb-txt-font-family)</FbText>.</FbText>
                        <FbInputText TAction="FbSetValue<string>" Value="@Model.FontFamilyXS" ValueChanged="@(value => Model.FontFamilyXS = value)">
                            <StartContent><FbRowItem Style="min-width:3rem"><FbText S Subtle>XS</FbText></FbRowItem></StartContent>
                        </FbInputText>
                        <FbInputText TAction="FbSetValue<string>" Value="@Model.FontFamilyS" ValueChanged="@(value => Model.FontFamilyS = value)">
                            <StartContent><FbRowItem Style="min-width:3rem"><FbText S Subtle>S</FbText></FbRowItem></StartContent>
                        </FbInputText>
                        <FbInputText TAction="FbSetValue<string>" Value="@Model.FontFamilyM" ValueChanged="@(value => Model.FontFamilyM = value)">
                            <StartContent><FbRowItem Style="min-width:3rem"><FbText S Subtle>M</FbText></FbRowItem></StartContent>
                        </FbInputText>
                        <FbInputText TAction="FbSetValue<string>" Value="@Model.FontFamilyL" ValueChanged="@(value => Model.FontFamilyL = value)">
                            <StartContent><FbRowItem Style="min-width:3rem"><FbText S Subtle>L</FbText></FbRowItem></StartContent>
                        </FbInputText>
                        <FbInputText TAction="FbSetValue<string>" Value="@Model.FontFamilyXL" ValueChanged="@(value => Model.FontFamilyXL = value)">
                            <StartContent><FbRowItem Style="min-width:3rem"><FbText S Subtle>XL</FbText></FbRowItem></StartContent>
                        </FbInputText>
                        <FbInputText TAction="FbSetValue<string>" Value="@Model.FontFamilyXXL" ValueChanged="@(value => Model.FontFamilyXXL = value)">
                            <StartContent><FbRowItem Style="min-width:3rem"><FbText S Subtle>XXL</FbText></FbRowItem></StartContent>
                        </FbInputText>
                    </FbStack>
                </FbGridItem>
                <FbGridItem>
                    <FbStack GM PL WBA WFL WRL>
                        <FbText L B>Échelle</FbText>
                        <ValueSlider Label="XS" Unit="" Min="0.5" Max="3" Step="0.05" @bind-Value="Model.CoefXS" />
                        <ValueSlider Label="S" Unit="" Min="0.5" Max="3" Step="0.05" @bind-Value="Model.CoefS" />
                        <ValueSlider Label="M" Unit="" Min="0.5" Max="3" Step="0.05" @bind-Value="Model.CoefM" />
                        <ValueSlider Label="L" Unit="" Min="0.5" Max="3" Step="0.05" @bind-Value="Model.CoefL" />
                        <ValueSlider Label="XL" Unit="" Min="0.5" Max="3" Step="0.05" @bind-Value="Model.CoefXL" />
                        <ValueSlider Label="XXL" Unit="" Min="0.5" Max="3" Step="0.05" @bind-Value="Model.CoefXXL" />
                    </FbStack>
                </FbGridItem>
                <FbGridItem>
                    <FbStack GM PL WBA WFL WRL>
                        <FbText L B>Graisses</FbText>
                        <ValueSlider Label="Fine" Unit="" Min="100" Max="900" Step="100" @bind-Value="Model.WeightThin" />
                        <ValueSlider Label="Normale" Unit="" Min="100" Max="900" Step="100" @bind-Value="Model.WeightDefault" />
                        <ValueSlider Label="Grasse" Unit="" Min="100" Max="900" Step="100" @bind-Value="Model.WeightBold" />
                        <ValueSlider Label="Très grasse" Unit="" Min="100" Max="900" Step="100" @bind-Value="Model.WeightExtraBold" />
                    </FbStack>
                </FbGridItem>
            </FbGridContainer>
            <FbRow JHE>
                <FbButton WBN OnClick="Model.ResetTypography"><FbIcon Icon="@FbMaterialIcons.RestartAlt" /><FbText S>Réinitialiser la typographie</FbText></FbButton>
            </FbRow>
            break;

        default:
            <FbGridContainer Columns="1" ColumnsM="2" ColumnsXL="3" GL JVS>
                <FbGridItem>
                    <FbStack GM PL WBA WFL WRL>
                        <FbText L B>Couleurs</FbText>
                        <FbSelect TValue="string" TAction="FbSetValue<string>" Items="ThemeEditorModel.Branches"
                                  Value="@Model.Branch" ValueChanged="Model.SelectBranch">
                            <StartContent><FbRowItem Style="min-width:6.5rem"><FbText S Subtle>Branche</FbText></FbRowItem></StartContent>
                        </FbSelect>
                        <ColorField Label="Teinte" @bind-Value="Model.TintColor" @bind-Clipboard="Model.CopiedColor" />
                        <ValueSlider Label="Mélange teinte" @bind-Value="Model.TintMix" />
                        <FbText XS Muted>
                            Toutes les ancres de la branche penchent vers la teinte en gardant leur luminosité. Un gris
                            baisse l’intensité de toutes les couleurs.
                        </FbText>
                        <FbSelect TValue="string" TAction="FbSetValue<string>" Items="Model.VariantNames"
                                  @bind-Value="Model.SelectedVariant">
                            <StartContent><FbRowItem Style="min-width:6.5rem"><FbText S Subtle>Variante</FbText></FbRowItem></StartContent>
                        </FbSelect>
                        <ColorField Label="Ancre 0 %" @bind-Value="Model.Selected.Low" @bind-Clipboard="Model.CopiedColor" />
                        <ColorField Label="Ancre 50 %" @bind-Value="Model.Selected.Mid" @bind-Clipboard="Model.CopiedColor" />
                        <ColorField Label="Ancre 100 %" @bind-Value="Model.Selected.High" @bind-Clipboard="Model.CopiedColor" />
                        <FbText XS Muted>
                            Un seul dégradé par variante : fonds, textes et filets en sont des positions.
                        </FbText>
                    </FbStack>
                </FbGridItem>

                <FbGridItem>
                    <FbStack GM PL WBA WFL WRL>
                        <FbText L B>Surfaces et filets</FbText>
                        <ValueSlider Label="Neutre" Max="50" @bind-Value="Model.NeutralMix" />
                        <ValueSlider Label="Surface" Max="50" @bind-Value="Model.SurfaceOffset" />
                        <ValueSlider Label="Accent" Max="50" @bind-Value="Model.AccentOffset" />
                        <ValueSlider Label="Highlight" Max="100" @bind-Value="Model.HighlightOffset" />
                        <ValueSlider Label="Survol" Max="30" @bind-Value="Model.HoverOffset" />
                        <FbText XS Muted>
                            La page est au neutre. Chaque fond ajoute son offset au neutre du bloc qui le contient,
                            sur six niveaux d’imbrication ; ses textes et ses filets se placent depuis ce nouveau neutre.
                        </FbText>
                        <ValueSlider Label="Frame Light" Max="50" @bind-Value="Model.FrameLight" />
                        <ValueSlider Label="Frame Medium" Max="50" @bind-Value="Model.FrameMedium" />
                        <ValueSlider Label="Frame Strong" Max="50" @bind-Value="Model.FrameStrong" />
                    </FbStack>
                </FbGridItem>

                <FbGridItem>
                    <FbStack GM PL WBA WFL WRL>
                        <FbText L B>Textes</FbText>
                        <ValueSlider Label="Subtle" @bind-Value="Model.TextSubtle" />
                        <ValueSlider Label="Muted" @bind-Value="Model.TextMuted" />
                        <ValueSlider Label="Default" @bind-Value="Model.TextDefault" />
                        <ValueSlider Label="Highlight" @bind-Value="Model.TextHighlight" />

                        <FbText L B>Contraste WCAG</FbText>
                        <FbText XS Muted>Plus faible ratio de chaque texte, sur les fonds de premier niveau de toutes les variantes sauf Disabled : WCAG n’exige aucun contraste d’un contrôle inactif.</FbText>
                        @foreach (var (text, entry) in WorstContrasts)
                        {
                            <FbVariant Variant="@(entry.MeetsAA ? FbThemeVariants.Success : entry.MeetsAALarge ? FbThemeVariants.Warning : FbThemeVariants.Error)">
                                <FbRow GS PS PHM WBA WRM>
                                    <FbText S B>@text</FbText>
                                    <FbText S>@entry.Ratio.ToString("0.0"):1</FbText>
                                    <FbRowSpacer />
                                    <FbText XS Muted>@entry.Variant sur @entry.Background</FbText>
                                </FbRow>
                            </FbVariant>
                        }
                    </FbStack>
                </FbGridItem>
            </FbGridContainer>
            <FbRow JHE>
                <FbButton WBN OnClick="Model.ResetBranch"><FbIcon Icon="@FbMaterialIcons.RestartAlt" /><FbText S>Réinitialiser la branche @Model.Branch</FbText></FbButton>
            </FbRow>
            break;
    }

    <FbTheme Setup="@Model.Setup" Branch="@Model.Branch" Scoped>
        <ThemePreview />
    </FbTheme>

    <FbStack GS PL WBA WFL WRL>
        <FbText L B>Code du thème</FbText>
        <FbText XS Muted>Seules les valeurs modifiées sont déclarées : le reste est hérité du thème par défaut.</FbText>
        <pre style="margin:0;overflow:auto"><code>@Model.ToCSharp()</code></pre>
    </FbStack>
</FbStack>

@code {
    private static readonly IReadOnlyList<object> EditTabs = ["Espacements et rayons", "Typographie", "Branches et mélanges"];

    [Parameter]
    public ThemeEditorPage Item { get; set; } = default!;

    private int _contrastVersion = -1;
    private IReadOnlyList<(FbContrastText Text, FbContrastEntry Entry)> _worst = [];
    private bool _confirmReset;

    protected override Task OnInitializedAsync() => AutoSave.RestoreAsync();

    /// <summary>
    /// Every edit re-renders this view: saving after the render keeps the browser up to date.
    /// When the restore could not run before (no interactive JS yet), it runs here.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (await AutoSave.RestoreAsync())
            StateHasChanged();
        else
            await AutoSave.SaveAsync();
    }

    private void ResetAll()
    {
        Model.ResetAll();
        _confirmReset = false;
    }

    /// <summary>
    /// Recomputed only when the edited theme changes.
    /// </summary>
    private IReadOnlyList<(FbContrastText Text, FbContrastEntry Entry)> WorstContrasts
    {
        get
        {
            if (_contrastVersion != Model.Version)
            {
                var report = FbThemeContrast.Analyze(Registry.Resolve(Model.Setup, Model.Branch));
                _worst = report.Entries
                    .Where(entry => entry.Variant != FbThemeVariants.Disabled)
                    .GroupBy(entry => entry.Text)
                    .Select(group => (group.Key, group.MinBy(entry => entry.Ratio)!))
                    .ToList();
                _contrastVersion = Model.Version;
            }
            return _worst;
        }
    }
}
