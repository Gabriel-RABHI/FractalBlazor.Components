@* Source code shown as text: Razor never parses it. Attached, the block has square corners:
   it closes a frame, whose corners it takes when the frame is Joined. *@
<pre class="@(Attached ? "fb-site-code fb-site-code-attached" : "fb-site-code")"><code>@Code</code></pre>

@code {
    [Parameter, EditorRequired]
    public string Code { get; set; } = "";

    [Parameter]
    public bool Attached { get; set; }
}
