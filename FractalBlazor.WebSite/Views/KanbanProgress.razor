@* The progress of a kanban column or task: a thin bar in the Success variant, filled with
   its full color up to the share of done tasks. *@
<FbVariant Variant="@FbThemeVariants.Success">
    <FbRow NoFlex JVSt WBS WRR Style="height:4px">
        <FbRow NoFlex WBH WRR Style="@Width" />
    </FbRow>
</FbVariant>

@code {
    [Parameter]
    public int Done { get; set; }

    [Parameter]
    public int Total { get; set; }

    private string Width => FormattableString.Invariant($"width:{(Total == 0 ? 0 : 100.0 * Done / Total):0.#}%");
}
