@* The compact header, under 1024 px: the logo and the name, the flag assistant, then a menu
   that holds the sections and the links. *@
@attribute [ViewFor<ViewSelector>(typeof(HeaderState), ViewSelector.Summary)]

<FbImage Src="@HeaderView.Logo" L />
<FbText L B NW>@Item.Name</FbText>
<FbRowSpacer />
<FbDynamicView TSelector="ViewSelector" Item="Item.Flags" Selector="ViewSelector.Viewer" />
<FbDynamicView TSelector="ViewSelector" Item="Item.Menu" Selector="ViewSelector.Viewer" />

@code {
    [Parameter]
    public HeaderState Item { get; set; } = default!;
}
