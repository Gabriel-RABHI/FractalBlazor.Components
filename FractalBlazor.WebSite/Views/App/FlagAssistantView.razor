@* The flag assistant: a button in the header and the wide drawer it opens on the right.
   Every field, part and component only sends an action; the state computes the columns,
   the matches and the components, and this view re-renders alone. *@
@attribute [ViewFor<ViewSelector>(typeof(FlagAssistantState), ViewSelector.Viewer)]

<FbButton Handler="Item" Action="@Toggle" Title="Assistant des flags"
          WBH="@Item.IsOpen" WBN="@(!Item.IsOpen)" WFN PVS PHS>
    <FbIconImage Src="@SiteImages.Tool" L />
</FbButton>
<FbDrawer Modal Right IsOpen="@Item.IsOpen" IsOpenChanged="@SetOpen" Title="Assistant des flags" Size="76rem" WFL>
    <FbStack NoFlex GL PL JVS>
        <FbRow NoFlex GS JVC>
            <FbIconImage Src="@SiteImages.Tool" L />
            <FbText L B>Assistant des flags</FbText>
            <FbRowSpacer />
            <FbText S Muted NW>@Count</FbText>
            <FbButton Handler="Item" Action="@Toggle" Icon="@FbMaterialIcons.Close" Title="Fermer" WBN WFN PVS PHS />
        </FbRow>

        @* The first flags that start with the field, one per cell. The grid always has the
           same cells, empty or not: its height does not move while typing. *@
        <FbGridContainer TemplateColumns="repeat(auto-fill, minmax(min(18rem, 100%), 1fr))" AutoRows="3.5rem" GS>
            @for (var i = 0; i < MatchesShown; i++)
            {
                var flag = i < Item.Matches.Count ? Item.Matches[i] : null;
                <FbGridItem @key="i">
                    @if (flag is not null)
                    {
                        <FbButton Handler="Item" Action="@(new FlagAssistantState.ChooseFlag(flag.Name))" WBA WFL WRM PHM
                                  Style="flex-direction:column;align-items:flex-start;justify-content:center;gap:0;width:100%;height:100%">
                            <FbText M B NW>@flag.Name</FbText>
                            <FbText S Muted NW TR>@flag.Meaning</FbText>
                        </FbButton>
                    }
                </FbGridItem>
            }
        </FbGridContainer>

        <FbStackSeparator WFL />

        @* Columns separated by a line; on a narrow screen, the components go below. *@
        <FbRow NoFlex MultiLine GM JVS WSL>
            <FbRow MultiLine GM JVS PRM MinWidth="min(32rem, 100%)">
                <FbStack NoFlex GS JVS PRM MinWidth="13rem">
                    <FbText S B Subtle>Flag</FbText>
                    <FbInputText TAction="FlagAssistantState.SetQuery" Handler="Item" Value="@Item.Query" Immediate
                                 Placeholder="PVS">
                        <EndContent>
                            @* Always there, hidden while empty: the field keeps its height. *@
                            <FbButton Handler="Item" Action="@ClearQuery" Icon="@FbMaterialIcons.Close" Title="Effacer"
                                      WBN WFN PVS PHS Style="@HiddenWhenEmpty(Item.Query)" />
                        </EndContent>
                    </FbInputText>
                    @if (Item.Columns.Count > 0)
                    {
                        @Choices(Item.Columns[0])
                    }
                </FbStack>
                @foreach (var column in Item.Columns.Skip(1))
                {
                    <FbStack @key="column.Index" NoFlex GS JVS PRM MinWidth="11rem" WBA WFM PM WRM>
                        @Choices(column)
                    </FbStack>
                }
            </FbRow>

            <FbStack NoFlex GS JVS Style="width:18rem">
                <FbText S B Subtle>Composants</FbText>
                <FbInputText TAction="FlagAssistantState.SetComponentQuery" Handler="Item" Value="@Item.ComponentQuery" Immediate
                             Placeholder="FbRow, Text…">
                    <StartContent>
                        <FbIcon Icon="@FbMaterialIcons.Search" Subtle />
                    </StartContent>
                    <EndContent>
                        <FbButton Handler="Item" Action="@ClearComponentQuery" Icon="@FbMaterialIcons.Close" Title="Effacer"
                                  WBN WFN PVS PHS Style="@HiddenWhenEmpty(Item.ComponentQuery)" />
                    </EndContent>
                </FbInputText>
                <FbRow NoFlex MultiLine GS>
                    @foreach (var component in Item.Components)
                    {
                        var chosen = string.Equals(component, Item.ComponentQuery.Trim(), StringComparison.OrdinalIgnoreCase);
                        <FbButton @key="component" Handler="Item" Action="@(new FlagAssistantState.ChooseComponent(component))"
                                  WBH="@chosen" WBN="@(!chosen)" WFM WRX PVS PHM>
                            <FbText S NW Highlight="@chosen">@component</FbText>
                        </FbButton>
                    }
                </FbRow>
            </FbStack>
        </FbRow>
    </FbStack>
</FbDrawer>

@code {
    private const int MatchesShown = 2;
    private static readonly PopupState.Toggle Toggle = new();
    private static readonly FlagAssistantState.ClearQuery ClearQuery = new();
    private static readonly FlagAssistantState.ClearComponentQuery ClearComponentQuery = new();

    [Parameter]
    public FlagAssistantState Item { get; set; } = default!;

    private string Count => Item.Matches.Count switch
    {
        0 => $"Aucun flag ne commence par « {Item.Query} »",
        1 => "1 flag",
        var count => $"{count} flags"
    };

    private void SetOpen(bool open) => Item.Handle(new PopupState.SetOpen(open));

    private static string? HiddenWhenEmpty(string text) => text.Length > 0 ? null : "visibility:hidden";

    /// <summary>
    /// The parts of a column, under the title of their kind: the selected ones stand out.
    /// </summary>
    private RenderFragment Choices(FlagColumn column) => @<text>
        @foreach (var group in column.Groups)
        {
            <FbStackItem MVM>
                <FbText S B Subtle>@group.Category</FbText>
            </FbStackItem>
            @foreach (var choice in group.Choices)
            {
                var selected = choice.State == FlagChoiceState.Selected;
                <FbRow NoFlex GS JVC>
                    <FbRowItem Style="min-width:3.5rem;flex:none">
                        <FbText M B NW>@choice.Token.Code</FbText>
                    </FbRowItem>
                    <FbButton Handler="Item" Action="@(new FlagAssistantState.ChooseToken(column.Index, choice.Token))"
                              Variant="@(selected ? FbThemeVariants.Selected : null)" WBH="@selected" WBA="@(!selected)"
                              WFN PVS PHM Style="flex:1" WFM>
                        <FbText S NW>@choice.Token.Meaning</FbText>
                    </FbButton>
                </FbRow>
            }
        }
    </text>;
}
