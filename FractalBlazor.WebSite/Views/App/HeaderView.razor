@* The header on a wide screen, inside the bar of the application view: the logo and the
   name on the left; on the right, the sections of the top menu, the flag assistant, then the
   links as icons. The logo is decorative: the name beside it says the same. *@
@attribute [ViewFor<ViewSelector>(typeof(HeaderState), ViewSelector.Viewer)]

<FbImage Src="@Logo" L />
<FbText L B NW>@Item.Name</FbText>
<FbRowSpacer />
@foreach (var section in Item.Sections)
{
    <FbDynamicView @key="section" TSelector="ViewSelector" Item="section" Selector="ViewSelector.Viewer" />
}
<FbDynamicView TSelector="ViewSelector" Item="Item.Flags" Selector="ViewSelector.Viewer" />
@foreach (var link in Item.Links)
{
    <FbDynamicView @key="link" TSelector="ViewSelector" Item="link" Selector="ViewSelector.Summary" />
}

@code {
    /// <summary>
    /// The logo of the site, served from the static assets of this library.
    /// </summary>
    internal const string Logo = "_content/FractalBlazor.WebSite/images/logo-fractal-blazor-small-64.png";

    [Parameter]
    public HeaderState Item { get; set; } = default!;
}
