@* A section of the top menu, in the header or in its compact menu, where the entries are
   aligned on the left. It re-renders alone when its selection changes. *@
@attribute [ViewFor<ViewSelector>(typeof(SectionState), ViewSelector.Viewer)]

<FbButton Handler="Item" Action="@Select" WBH="@Item.IsSelected" WBN="@(!Item.IsSelected)" WFN PVS PHM
          Style="justify-content:flex-start">
    <FbText S NW Highlight="@Item.IsSelected" Muted="@(!Item.IsSelected)">@MenuIntents.Label(Item.Intent)</FbText>
</FbButton>

@code {
    private static readonly SelectableEntryState.Select Select = new();

    [Parameter]
    public SectionState Item { get; set; } = default!;
}
