@* The menu on the left under 1024 px: a button on the second line of the header and the
   drawer it opens, on top of the whole page. The button only shows for a section that has
   a menu. Escape or a click outside only send the closing to the state; the navigation
   closes the drawer once the chosen page is open. It re-renders alone. *@
@attribute [ViewFor<ViewSelector>(typeof(MenuDrawerState), ViewSelector.Viewer)]

@if (Item.HasMenu)
{
    <FbButton Handler="Item" Action="@Toggle" Title="Menu"
              WBH="@Item.IsOpen" WBN="@(!Item.IsOpen)" WFN PVS PHS><FbIcon Icon="@FbMaterialIcons.Menu" /></FbButton>
}
<FbDrawer Modal Left IsOpen="@Item.IsOpen" IsOpenChanged="@SetOpen" Title="Menu" Size="16rem" WFL>
    <FbDynamicView TSelector="ViewSelector" Item="Item.Menu" Selector="ViewSelector.Summary" />
</FbDrawer>

@code {
    private static readonly PopupState.Toggle Toggle = new();

    [Parameter]
    public MenuDrawerState Item { get; set; } = default!;

    private void SetOpen(bool open) => Item.Handle(new PopupState.SetOpen(open));
}
