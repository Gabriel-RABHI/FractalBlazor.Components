@* The application shell. Each area is a state rendered by the view declared for its type:
   this view only lays them out, in a page anchor that fills the window. The layout follows
   the screen state, which the width sensor keeps informed. Under 1024 px the header takes
   its compact view (Summary) and gains a second line: the button of the drawer that now
   carries the menu on the left, and the trail of the open page. *@
@attribute [ViewFor<ViewSelector>(typeof(RootState), ViewSelector.Viewer)]

<FbPageAnchor>
    <FbWidthSensor TAction="ScreenState.SetWidth" Handler="Item.Screen" Value="Item.Screen.Width" />
    <FbStack>
        <FbStack NoFlex WFL WSL>
            <FbRow NoFlex GM PHL PVM JVC>
                <FbDynamicView TSelector="ViewSelector" Item="Item.Header" Selector="HeaderView" />
            </FbRow>
            @if (Item.Screen.Compact)
            {
                <FbRow NoFlex GS PHL PVS JVC>
                    <FbDynamicView TSelector="ViewSelector" Item="Item.Navigation.Drawer" Selector="ViewSelector.Viewer" />
                    <FbDynamicView TSelector="ViewSelector" Item="Item.Navigation.Content" Selector="ViewSelector.Summary" />
                </FbRow>
            }
        </FbStack>
        <FbRow JVSt>
            @if (!Item.Screen.Compact)
            {
                <FbDynamicView TSelector="ViewSelector" Item="Item.Navigation.SideMenu" Selector="ViewSelector.Viewer" />
            }
            <FbDynamicView TSelector="ViewSelector" Item="Item.Navigation.Content" Selector="ViewSelector.Viewer" />
        </FbRow>
        <FbDynamicView TSelector="ViewSelector" Item="Item.Footer" Selector="ViewSelector.Viewer" />
    </FbStack>
</FbPageAnchor>

@code {
    [Parameter]
    public RootState Item { get; set; } = default!;

    private ViewSelector HeaderView => Item.Screen.Compact ? ViewSelector.Summary : ViewSelector.Viewer;
}
