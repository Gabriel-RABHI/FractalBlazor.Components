@attribute [ViewFor<ViewSelector>(typeof(ExternalLinkState), ViewSelector.Viewer)]

<a class="fb-site-link" href="@Item.Url" target="_blank" rel="noopener noreferrer">
    @if (MenuIntents.Image(Item.Intent) is { } image)
    {
        <FbIconImage Src="@image" />
    }
    else
    {
        <FbIcon Icon="@MenuIntents.Icon(Item.Intent)" />
    }
    <span>@MenuIntents.Label(Item.Intent)</span>
</a>

@code {
    [Parameter]
    public ExternalLinkState Item { get; set; } = default!;
}
