@* The interactive root of the site, the same for every host. The whole application is
   RootState, rendered by the view declared for its type. *@
@inject RootState Root

<FbDynamicView TSelector="ViewSelector" Item="Root" Selector="ViewSelector.Viewer" />

@code {
    /// <summary>
    /// Mode read from <see cref="ThemeCookie"/> by the host before the first render.
    /// </summary>
    [Parameter]
    public ThemeMode InitialMode { get; set; }

    protected override void OnInitialized()
        => Root.Footer.Theme.Handle(new ThemeSelectorState.SetMode(InitialMode));
}
