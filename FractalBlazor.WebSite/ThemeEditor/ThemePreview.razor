@* Components drawn with the edited theme, in tabs. The open tab and the options of each tab
   live in the editor model, so they survive a change of tab and navigation. *@
@inject ThemeEditorModel Model

<FbStack GL PL WBS WFM WRL>
    <FbText XL B>Aperçu</FbText>
    <FbTabs TAction="FbSetValue<int>" @bind-Value="Model.PreviewTab" Items="Tabs" />

    @switch (Model.PreviewTab)
    {
        case 0:
            <SurfaceGrid />
            break;
        case 1:
            <PreviewTexts />
            break;
        case 2:
            <PreviewVariants />
            break;
        case 3:
            <PreviewButtons />
            break;
        case 4:
            <PreviewForm />
            break;
        default:
            <PreviewShape />
            break;
    }
</FbStack>

@code {
    private static readonly IReadOnlyList<object> Tabs =
        ["Surfaces et frames", "Textes", "Variantes", "Boutons", "Formulaire", "Espacements et rayons"];
}
